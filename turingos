#!/usr/bin/env bash
# turingos — TuringOS main entrypoint
#
# Installed on the Debian ISO as /usr/bin/turingos, with modules in
# /usr/lib/turingos. From a checkout, the modules next to this script win.
# Run `turingos help` for the command list.

set -euo pipefail

TURINGOS_VERSION="1.2"

# ─── Resolve Library Path ─────────────────────────────────────────────────────

_SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
if [[ -f "${_SCRIPT_DIR}/core/config.sh" ]]; then
    TURINGOS_ROOT="$_SCRIPT_DIR"
else
    TURINGOS_ROOT="/usr/lib/turingos"
fi
export TURINGOS_ROOT

# ─── Modules (core first; order matters only for source-time globals) ────────

for _module in \
    core/config.sh core/ui.sh core/logging.sh core/init.sh \
    sandbox/btrfs.sh sandbox/diff.sh \
    agent/nim.sh agent/model.sh agent/claude.sh \
    bazaar/registry.sh bazaar/install.sh \
    game/gamemode.sh monitor/system.sh voice/voice.sh; do
    # shellcheck source=/dev/null
    source "${TURINGOS_ROOT}/${_module}"
done
unset _module

# ─── Dashboard (interactive gum/fzf menu) ────────────────────────────────────

cmd::dashboard() {
    ui::banner
    local choice
    while true; do
        choice=$(ui::choose "TuringOS Dashboard" \
            "Agent → Start" "Agent → Status" "Agent → Logs" \
            "Sandbox → Create" "Sandbox → Diff" "Sandbox → Merge" "Sandbox → Rollback" "Sandbox → List" \
            "Bazaar → Browse" "Bazaar → Installed" \
            "Game Mode → On" "Game Mode → Off" "Game Mode → Status" \
            "System Status" "Live Monitor" "API Spend" "Quit") || true

        [[ -z "$choice" || "$choice" == "Quit" ]] && break

        # Each action reports its own errors; keep the menu alive either way
        case "$choice" in
            "Agent → Start")      agent::start ;;
            "Agent → Status")     agent::status ;;
            "Agent → Logs")       agent::logs ;;
            "Sandbox → Create")   sandbox::create >/dev/null ;;
            "Sandbox → Diff")     diff::show ;;
            "Sandbox → Merge")    sandbox::merge ;;
            "Sandbox → Rollback") sandbox::rollback ;;
            "Sandbox → List")     sandbox::list ;;
            "Bazaar → Browse")    registry::browse ;;
            "Bazaar → Installed") registry::installed ;;
            "Game Mode → On")     gamemode::on ;;
            "Game Mode → Off")    gamemode::off ;;
            "Game Mode → Status") gamemode::status ;;
            "System Status")      monitor::status ;;
            "Live Monitor")       monitor::watch ;;
            "API Spend")          monitor::spend ;;
        esac || true

        echo ""
        read -rp "  Press Enter to continue..." _
        clear
        ui::banner
    done
}

# ─── Help ─────────────────────────────────────────────────────────────────────

cmd::help() {
    ui::banner
    cat <<'HELP'
  USAGE
    turingos <command> [subcommand] [args...]

  AGENT
    agent start [project] [task]   Start the agent in a sandbox
    agent stop                     Stop the running agent
    agent status                   Show agent state + recent output
    agent logs                     Tail agent session log

  SANDBOX
    sandbox create [project] [label]   Create Btrfs/copy sandbox
    sandbox diff   [sandbox]           Show what the agent changed
    sandbox merge  [sandbox]           Apply changes to original project
    sandbox rollback [sandbox]         Discard sandbox
    sandbox list                       List all sandboxes
    sandbox status                     Show active sandbox

  BAZAAR
    bazaar                         Browse tools (fzf UI)
    bazaar search <query>          Search registry
    bazaar info <tool>             Show tool details
    bazaar install <tool>          Install + register with Claude Code
    bazaar uninstall <tool>        Remove tool + MCP config entry
    bazaar installed               List installed tools

  GAME MODE
    game on                        Deprioritize agents, boost interactive
    game off                       Restore normal priorities
    game status                    Show current state
    game watch                     Auto-detect game launches (background)

  MONITOR
    status                         One-shot system + agent HUD
    monitor                        Same as status
    monitor watch                  Live refreshing dashboard
    monitor spend                  API token usage + cost estimate

  MODELS
    model status                   Show provider + ping endpoint
    model set <provider> [endpoint] [model]
                                   claude | nvidia | ollama | openrouter | custom
                                   (nvidia with no model opens the model picker)
    model use <model>              Change the default model
    image "<prompt>" [out.jpg]     Generate an image with NVIDIA FLUX

  VOICE
    voice status                   Show the speech-to-text backend
    voice backend whisper|wispr    Pick local Whisper or Wispr Flow
    voice wispr-import <session.json> [config.json]
                                   Use a Wispr Flow session (unofficial)

  OTHER
    init                           First-time setup + dependency check
    dashboard                      Interactive menu
    ui                             Open the desktop UI
    logs [N]                       Show last N lines of TuringOS log
    version                        Print version
    help                           This message

HELP
}

# ─── Router ───────────────────────────────────────────────────────────────────

main() {
    local cmd="${1:-}" sub="${2:-}"
    shift "$(( $# < 2 ? $# : 2 ))"

    case "$cmd" in
        ui)
            # Installed: the turingos-ui binary. Checkout: ui/run.sh.
            if command -v turingos-ui &>/dev/null; then
                exec turingos-ui ${sub:+"$sub"} "$@"
            elif [[ -x "${TURINGOS_ROOT}/ui/run.sh" ]]; then
                exec "${TURINGOS_ROOT}/ui/run.sh" ${sub:+"$sub"} "$@"
            fi
            ui::fail "TuringOS UI not found (no turingos-ui, no ui/run.sh)"
            exit 1
            ;;
        init)      init::run ;;
        dashboard) cmd::dashboard ;;
        agent)
            case "$sub" in
                start)     agent::start "$@" ;;
                stop)      agent::stop ;;
                status|"") agent::status ;;
                logs)      agent::logs ;;
                *)         ui::fail "Unknown agent subcommand: ${sub}"; exit 1 ;;
            esac
            ;;
        sandbox)
            case "$sub" in
                create)    sandbox::create "$@" >/dev/null ;;
                diff)      diff::show "$@" ;;
                merge)     sandbox::merge "$@" ;;
                rollback)  sandbox::rollback "$@" ;;
                list)      sandbox::list ;;
                status|"") sandbox::status ;;
                *)         ui::fail "Unknown sandbox subcommand: ${sub}"; exit 1 ;;
            esac
            ;;
        bazaar)
            case "$sub" in
                search)    registry::search "$@" ;;
                info)      registry::info "$@" ;;
                install)   bazaar::install "$@" ;;
                uninstall) bazaar::uninstall "$@" ;;
                installed) registry::installed ;;
                "")        registry::browse ;;
                *)
                    ui::warn "Unknown bazaar subcommand '${sub}'"
                    ui::info "Did you mean: turingos bazaar install ${sub}?"
                    exit 1
                    ;;
            esac
            ;;
        game)
            case "$sub" in
                on)        gamemode::on ;;
                off)       gamemode::off ;;
                status|"") gamemode::status ;;
                watch)     gamemode::watch ;;
                *)         ui::fail "Unknown game subcommand: ${sub}"; exit 1 ;;
            esac
            ;;
        status) monitor::status ;;
        monitor)
            case "$sub" in
                watch)  monitor::watch "$@" ;;
                spend)  monitor::spend ;;
                "")     monitor::status ;;
                *)      ui::fail "Unknown monitor subcommand: ${sub}"; exit 1 ;;
            esac
            ;;
        model) model::cmd ${sub:+"$sub"} "$@" ;;
        image) nim::image "$sub" "$@" ;;
        voice) voice::cmd ${sub:+"$sub"} "$@" ;;
        logs)  log::tail "${sub:-50}" ;;
        version | --version | -v) echo "  TuringOS v${TURINGOS_VERSION}" ;;
        help | --help | -h | "")  cmd::help ;;
        *)
            ui::fail "Unknown command: ${cmd}"
            echo ""
            cmd::help
            exit 1
            ;;
    esac
}

main "$@"
