#!/usr/bin/env bash
# turingos — TuringOS main entrypoint
#
# Usage:
#   turingos init
#   turingos dashboard
#   turingos agent start [PROJECT] [TASK]
#   turingos agent stop
#   turingos agent status
#   turingos agent logs
#   turingos sandbox create [PROJECT] [LABEL]
#   turingos sandbox diff   [SANDBOX]
#   turingos sandbox merge  [SANDBOX]
#   turingos sandbox rollback [SANDBOX]
#   turingos sandbox list
#   turingos sandbox status
#   turingos bazaar
#   turingos bazaar search <query>
#   turingos bazaar info <tool>
#   turingos bazaar install <tool>
#   turingos bazaar uninstall <tool>
#   turingos bazaar installed
#   turingos game on
#   turingos game off
#   turingos game status
#   turingos game watch
#   turingos status
#   turingos monitor
#   turingos monitor watch
#   turingos monitor spend
#   turingos logs [lines]
#   turingos version
#   turingos help

set -euo pipefail

TURINGOS_VERSION="0.1.0"

# ─── Resolve Library Path ─────────────────────────────────────────────────────
# When installed via PKGBUILD: modules live in /usr/lib/turingos/
# When running from a local checkout: modules are next to this script.

_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ -d "/usr/lib/turingos" ]]; then
    _LIB_DIR="/usr/lib/turingos"
else
    _LIB_DIR="${_SCRIPT_DIR}"
fi

# ─── Source Core (must come first) ───────────────────────────────────────────

source "${_LIB_DIR}/core/config.sh"
source "${_LIB_DIR}/core/ui.sh"
source "${_LIB_DIR}/core/logging.sh"

# ─── Source Modules ───────────────────────────────────────────────────────────

source "${_LIB_DIR}/sandbox/btrfs.sh"
source "${_LIB_DIR}/sandbox/diff.sh"
source "${_LIB_DIR}/agent/claude.sh"
source "${_LIB_DIR}/bazaar/registry.sh"
source "${_LIB_DIR}/bazaar/install.sh"
source "${_LIB_DIR}/game/gamemode.sh"
source "${_LIB_DIR}/monitor/system.sh"

# ─── Init ─────────────────────────────────────────────────────────────────────

cmd::init() {
    ui::banner

    ui::info "Initializing TuringOS..."
    echo ""

    # Create runtime dirs
    config::init_dirs
    ui::ok "Runtime directories created: ${TURINGOS_DATA_DIR}"

    # Check optional dependencies
    echo ""
    ui::info "Checking dependencies..."
    echo ""

    local deps_required=("git" "jq")
    local deps_optional=("gum" "fzf" "btrfs" "nvidia-smi" "notify-send" "rsync")

    local all_ok=true
    for dep in "${deps_required[@]}"; do
        if command -v "$dep" &>/dev/null; then
            ui::status_row "$dep" "found" "ok"
        else
            ui::status_row "$dep" "MISSING (required)" "fail"
            all_ok=false
        fi
    done

    echo ""
    for dep in "${deps_optional[@]}"; do
        if command -v "$dep" &>/dev/null; then
            ui::status_row "$dep" "found" "ok"
        else
            ui::status_row "$dep" "not found (optional)" "warn"
        fi
    done

    # ── Claude Code CLI check ─────────────────────────────────────────────────
    echo ""
    ui::divider
    echo ""
    if command -v claude &>/dev/null; then
        local claude_ver
        claude_ver=$(claude --version 2>/dev/null || echo "installed")
        ui::status_row "Claude Code CLI" "$claude_ver" "ok"
    else
        ui::status_row "Claude Code CLI" "NOT FOUND" "fail"
        echo ""
        ui::warn "Claude Code CLI is required to run agents."
        echo ""
        if ui::confirm "Install Claude Code CLI now?"; then
            echo ""
            # Locate the install script
            local install_script=""
            for candidate in \
                "${_LIB_DIR}/../pkg/turingos-install-claude-cli.sh" \
                "/usr/lib/turingos/pkg/turingos-install-claude-cli.sh" \
                "${_SCRIPT_DIR}/pkg/turingos-install-claude-cli.sh"; do
                if [[ -f "$candidate" ]]; then
                    install_script="$candidate"
                    break
                fi
            done

            if [[ -n "$install_script" ]]; then
                bash "$install_script"
            else
                ui::info "Run manually: curl -fsSL https://claude.ai/install.sh | sh"
                ui::info "Or:           brew install claude-code"
                ui::info "Or:           npm install -g @anthropic-ai/claude-code"
            fi
        else
            ui::info "Skip for now. Install later:"
            ui::info "  curl -fsSL https://claude.ai/install.sh | sh   (native)"
            ui::info "  brew install claude-code                        (Homebrew)"
            ui::info "  npm install -g @anthropic-ai/claude-code        (npm)"
        fi
    fi

    # ── API key check ─────────────────────────────────────────────────────────
    echo ""
    if [[ -n "${ANTHROPIC_API_KEY:-}" ]]; then
        ui::status_row "ANTHROPIC_API_KEY" "set" "ok"
    else
        # Check config.env
        local key_in_config
        key_in_config=$(grep '^ANTHROPIC_API_KEY=' "${TURINGOS_CONFIG_FILE}" 2>/dev/null | cut -d= -f2-)
        if [[ -n "$key_in_config" ]]; then
            ui::status_row "ANTHROPIC_API_KEY" "set (in config.env)" "ok"
        else
            ui::status_row "ANTHROPIC_API_KEY" "not set" "warn"
            ui::info "Set it: echo 'export ANTHROPIC_API_KEY=sk-ant-...' >> ~/.bashrc"
        fi
    fi

    echo ""
    ui::divider
    echo ""

    if $all_ok; then
        ui::ok "TuringOS initialized"
    else
        ui::warn "Some required dependencies are missing — install them before running agents"
    fi

    echo ""
    ui::info "Data dir:    ${TURINGOS_DATA_DIR}"
    ui::info "Config:      ${TURINGOS_CONFIG_FILE}"
    ui::info "Agent log:   ${TURINGOS_LOG_DIR}/"
    ui::info "Sandboxes:   ${TURINGOS_SANDBOX_DIR}/"
    echo ""
    ui::info "Next steps:"
    ui::info "  turingos agent start   — launch Claude in a safe sandbox"
    ui::info "  turingos bazaar        — browse MCP tools"
    ui::info "  turingos dashboard     — interactive menu"
    echo ""
}

# ─── Model Provider ───────────────────────────────────────────────────────────

cmd::model() {
    local sub="${1:-status}"; shift 2>/dev/null || true
    case "$sub" in
        set)
            local provider="${1:-}" endpoint="${2:-}" name="${3:-}"
            case "$provider" in
                claude | ollama | openrouter | custom) ;;
                *) ui::fail "Usage: turingos model set <claude|ollama|openrouter|custom> [endpoint] [model]"; return 1 ;;
            esac
            [[ "$provider" == "ollama" && -z "$endpoint" ]] && endpoint="http://localhost:11434"
            [[ "$provider" == "openrouter" && -z "$endpoint" ]] && endpoint="https://openrouter.ai/api/v1"
            config::set TURINGOS_MODEL_PROVIDER "$provider"
            config::set TURINGOS_MODEL_ENDPOINT "$endpoint"
            config::set TURINGOS_MODEL_NAME "$name"
            ui::ok "Model provider set to ${provider}${name:+ (${name})}"
            ;;
        status)
            ui::info "Provider: ${TURINGOS_MODEL_PROVIDER}"
            ui::info "Endpoint: ${TURINGOS_MODEL_ENDPOINT:-<default>}"
            ui::info "Model:    ${TURINGOS_MODEL_NAME:-<default>}"
            [[ "$TURINGOS_MODEL_PROVIDER" == "claude" || -z "$TURINGOS_MODEL_ENDPOINT" ]] && return 0
            local url="${TURINGOS_MODEL_ENDPOINT%/}/v1/models"
            [[ "$TURINGOS_MODEL_PROVIDER" == "ollama" ]] && url="${TURINGOS_MODEL_ENDPOINT%/}/api/tags"
            local auth=()
            [[ "$TURINGOS_MODEL_PROVIDER" == "openrouter" && -n "${OPENROUTER_API_KEY:-}" ]]                 && auth=(-H "Authorization: Bearer ${OPENROUTER_API_KEY}")
            if curl -fsS --max-time 5 "${auth[@]}" "$url" >/dev/null; then
                ui::ok "Endpoint reachable"
            else
                ui::fail "Endpoint unreachable: ${url}"
                return 1
            fi
            ;;
        *) ui::fail "Unknown model subcommand: ${sub}"; return 1 ;;
    esac
}

# ─── Dashboard (interactive gum/fzf menu) ────────────────────────────────────

cmd::dashboard() {
    ui::banner

    while true; do
        local choice
        choice=$(ui::choose "TuringOS Dashboard" \
            "◈  Agent → Start"          \
            "◈  Agent → Status"         \
            "◈  Agent → Logs"           \
            "⬡  Sandbox → Create"       \
            "⬡  Sandbox → Diff"         \
            "⬡  Sandbox → Merge"        \
            "⬡  Sandbox → Rollback"     \
            "⬡  Sandbox → List"         \
            "   Bazaar → Browse"        \
            "   Bazaar → Installed"     \
            "🎮  Game Mode → On"         \
            "🎮  Game Mode → Off"        \
            "🎮  Game Mode → Status"     \
            "   System Status"          \
            "   Live Monitor"           \
            "   API Spend"              \
            "   Quit"                   \
        )

        [[ -z "$choice" || "$choice" == *"Quit"* ]] && break

        case "$choice" in
            *"Agent → Start"*)     agent::start ;;
            *"Agent → Status"*)    agent::status ;;
            *"Agent → Logs"*)      agent::logs ;;
            *"Sandbox → Create"*)  sandbox::create ;;
            *"Sandbox → Diff"*)    diff::show ;;
            *"Sandbox → Merge"*)   sandbox::merge ;;
            *"Sandbox → Rollback"*)sandbox::rollback ;;
            *"Sandbox → List"*)    sandbox::list ;;
            *"Bazaar → Browse"*)   registry::browse ;;
            *"Bazaar → Installed"*)registry::installed ;;
            *"Game Mode → On"*)    gamemode::on ;;
            *"Game Mode → Off"*)   gamemode::off ;;
            *"Game Mode → Status"*)gamemode::status ;;
            *"System Status"*)     monitor::status ;;
            *"Live Monitor"*)      monitor::watch ;;
            *"API Spend"*)         monitor::spend ;;
        esac

        # Pause between actions so the user can read output
        echo ""
        read -rp "  Press Enter to continue..." _
        clear
        ui::banner
    done
}

# ─── Help ─────────────────────────────────────────────────────────────────────

cmd::help() {
    ui::banner
    cat <<'HELP'
  USAGE
    turingos <command> [subcommand] [args...]

  AGENT
    agent start [project] [task]   Start Claude in a sandbox
    agent stop                     Stop the running agent
    agent status                   Show agent state + recent output
    agent logs                     Tail agent session log

  SANDBOX
    sandbox create [project] [label]   Create Btrfs/copy sandbox
    sandbox diff   [sandbox]           Show what the agent changed
    sandbox merge  [sandbox]           Apply changes to original project
    sandbox rollback [sandbox]         Discard sandbox
    sandbox list                       List all sandboxes
    sandbox status                     Show active sandbox

  BAZAAR
    bazaar                         Browse tools (fzf UI)
    bazaar search <query>          Search registry
    bazaar info <tool>             Show tool details
    bazaar install <tool>          Install + wire into Claude Desktop
    bazaar uninstall <tool>        Remove tool + MCP config entry
    bazaar installed               List installed tools

  GAME MODE
    game on                        Deprioritize agents, boost interactive
    game off                       Restore normal priorities
    game status                    Show current state
    game watch                     Auto-detect game launches (background)

  MONITOR
    status                         One-shot system + agent HUD
    monitor                        Same as status
    monitor watch                  Live refreshing dashboard
    monitor spend                  API token usage + cost estimate

  MODELS
    model status                   Show provider + ping endpoint
    model set <provider> [endpoint] [model]
                                   claude | ollama | openrouter | custom

  OTHER
    init                           First-time setup + dependency check
    dashboard                      Interactive menu
    ui                             Open the ui-shell desktop UI
    logs [N]                       Show last N lines of TuringOS log
    version                        Print version
    help                           This message

HELP
}

# ─── Router ───────────────────────────────────────────────────────────────────

main() {
    local cmd="${1:-}"
    local sub="${2:-}"
    shift 2 2>/dev/null || shift "${#}" 2>/dev/null || true

    case "$cmd" in

        # ── Desktop UI ────────────────────────────────────────────────────────
        ui)
            # Repo checkout: ui/ sits next to this script. Debian image: the
            # UI lives in /opt/turingos-ui behind the turingos-ui launcher.
            if [[ -x "${_SCRIPT_DIR}/ui/run.sh" ]]; then
                exec "${_SCRIPT_DIR}/ui/run.sh" ${sub:+"$sub"} "$@"
            elif command -v turingos-ui &>/dev/null; then
                exec turingos-ui ${sub:+"$sub"} "$@"
            else
                echo "TuringOS UI not found (no ui/run.sh, no turingos-ui)." >&2
                exit 1
            fi
            ;;

        # ── Init / Setup ──────────────────────────────────────────────────────
        init)
            cmd::init
            ;;

        # ── Dashboard ─────────────────────────────────────────────────────────
        dashboard)
            cmd::dashboard
            ;;

        # ── Agent ─────────────────────────────────────────────────────────────
        agent)
            case "$sub" in
                start)   agent::start "$@" ;;
                stop)    agent::stop ;;
                status)  agent::status ;;
                logs)    agent::logs ;;
                "")      agent::status ;;
                *)       ui::fail "Unknown agent subcommand: ${sub}"; cmd::help; exit 1 ;;
            esac
            ;;

        # ── Sandbox ───────────────────────────────────────────────────────────
        sandbox)
            case "$sub" in
                create)   sandbox::create "$@" ;;
                diff)     diff::show "$@" ;;
                merge)    sandbox::merge "$@" ;;
                rollback) sandbox::rollback "$@" ;;
                list)     sandbox::list ;;
                status)   sandbox::status ;;
                "")       sandbox::status ;;
                *)        ui::fail "Unknown sandbox subcommand: ${sub}"; exit 1 ;;
            esac
            ;;

        # ── Bazaar ────────────────────────────────────────────────────────────
        bazaar)
            case "$sub" in
                search)    registry::search "$@" ;;
                info)      registry::info "$@" ;;
                install)   bazaar::install "$@" ;;
                uninstall) bazaar::uninstall "$@" ;;
                installed) registry::installed ;;
                "")        registry::browse ;;
                *)
                    # Treat unknown sub as a tool key to install
                    ui::warn "Unknown bazaar subcommand '${sub}'"
                    ui::info "Did you mean: turingos bazaar install ${sub}?"
                    exit 1
                    ;;
            esac
            ;;

        # ── Game Mode ─────────────────────────────────────────────────────────
        game)
            case "$sub" in
                on)     gamemode::on ;;
                off)    gamemode::off ;;
                status) gamemode::status ;;
                watch)  gamemode::watch ;;
                "")     gamemode::status ;;
                *)      ui::fail "Unknown game subcommand: ${sub}"; exit 1 ;;
            esac
            ;;

        # ── Monitor / Status ──────────────────────────────────────────────────
        status)
            monitor::status
            ;;

        monitor)
            case "$sub" in
                watch)  monitor::watch "${@}" ;;
                spend)  monitor::spend ;;
                "")     monitor::status ;;
                *)      ui::fail "Unknown monitor subcommand: ${sub}"; exit 1 ;;
            esac
            ;;

        # ── Model Provider ────────────────────────────────────────────────────
        model)
            cmd::model ${sub:+"$sub"} "$@"
            ;;

        # ── Logs ──────────────────────────────────────────────────────────────
        logs)
            local lines="${sub:-50}"
            log::tail "$lines"
            ;;

        # ── Meta ──────────────────────────────────────────────────────────────
        version | --version | -v)
            echo "  TuringOS v${TURINGOS_VERSION}"
            ;;

        help | --help | -h | "")
            cmd::help
            ;;

        *)
            ui::fail "Unknown command: ${cmd}"
            echo ""
            cmd::help
            exit 1
            ;;
    esac
}

main "$@"
