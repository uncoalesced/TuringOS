#!/bin/bash
# turingos-hyprland-autostart — exec-once from /etc/turingos/hyprland.conf.
# The Wayland twin of /etc/xdg/openbox/autostart: same safe mode, same
# desktop service, same respawned shell window. Runs once Hyprland is up.

set -u

# Dark surface until (and behind) the shell window covers the screen
swaybg -c "#0a0a0f" &

# ── Safe mode (boot menu "safe mode", kernel arg turingos.safe) ───────────────
# No agent, no UI: the desktop and a terminal.
if grep -qw turingos.safe /proc/cmdline; then
    exec foot
fi

# ── TuringOS UI ───────────────────────────────────────────────────────────────
# turingosd needs the session environment (DISPLAY for its X clients —
# XWayland — plus WAYLAND_DISPLAY), then starts like it does under openbox.
# turingos-kiosk is the shell window; turingos-respawn restarts it after a
# crash and opens a terminal if it keeps crashing.
(
    envs=(WAYLAND_DISPLAY)
    for v in DISPLAY XAUTHORITY XDG_SESSION_TYPE XDG_CURRENT_DESKTOP; do
        [[ -n "${!v:-}" ]] && envs+=("$v")
    done
    dbus-update-activation-environment --systemd "${envs[@]}" 2>/dev/null \
        || systemctl --user import-environment "${envs[@]}"
    systemctl --user restart turingosd.service
) &

turingos-respawn /usr/lib/turingos/session/turingos-kiosk &
