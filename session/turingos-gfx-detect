#!/bin/bash
# turingos-gfx-detect — does this machine draw with a GPU or in software, and
# which graphics level should the shell start at?
#
# Writes GFX_PATH (gpu|sw) and GFX_TIER (full|lite|minimal) to
# $XDG_RUNTIME_DIR/turingos/gfx.env and prints them. turingos-kiosk picks the
# browser flags from GFX_PATH; turingosd hands both to the page (/boot.js),
# which steps itself down further if frames turn out slow.
#
#   TURINGOS_GFX=gpu|sw                 skip detection
#   TURINGOS_GFX_TIER=full|lite|minimal skip the level choice
#
# A render node is not enough: VMs without 3D acceleration can have one that
# is llvmpipe underneath. The renderer string is the real test.

set -euo pipefail

# More pixels than this in software, and even the light level is too much
GFX_MAX_SOFT_PIXELS=2300000

# gfx::decide HAS_RENDER_NODE RENDERER CPUS PIXELS [FORCED_PATH] → "path tier"
gfx::decide() {
    local node="$1" renderer="$2" cpus="$3" pixels="$4" forced="${5:-}"
    local path=gpu tier=full
    if [[ "$forced" == gpu || "$forced" == sw ]]; then
        path="$forced"
    elif [[ "$node" != 1 || -z "$renderer" ]]; then
        path=sw
    elif grep -qiE 'llvmpipe|softpipe|swrast|swiftshader' <<<"$renderer"; then
        path=sw
    fi
    if [[ "$path" == sw ]]; then
        tier=lite
        if (( cpus <= 2 || pixels > GFX_MAX_SOFT_PIXELS )); then
            tier=minimal
        fi
    fi
    echo "$path $tier"
}

# The GPU path crashed the browser earlier in this boot (turingos-kiosk)
gfx::forced_software() {
    local flag="$1" boot
    boot="$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || true)"
    [[ -n "$boot" && -f "$flag" && "$(cat "$flag" 2>/dev/null)" == "$boot" ]]
}

gfx::screen_pixels() {
    local size
    # awk reads to the end: leaving early would kill xdpyinfo with SIGPIPE,
    # which pipefail turns into a failure of the whole line
    size="$(xdpyinfo 2>/dev/null | awk '/dimensions:/ && !seen { print $2; seen = 1 }' || true)"
    if [[ "$size" =~ ^([0-9]+)x([0-9]+)$ ]]; then
        echo $(( BASH_REMATCH[1] * BASH_REMATCH[2] ))
    else
        echo 0
    fi
}

gfx::main() {
    local run="${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is not set}/turingos"
    local state="${XDG_STATE_HOME:-${HOME}/.local/state}/turingos"
    local forced="${TURINGOS_GFX:-}" node=0 renderer="" path tier

    if [[ -z "$forced" ]] && gfx::forced_software "${state}/force-sw"; then
        forced=sw
    fi
    if compgen -G '/dev/dri/renderD*' >/dev/null; then
        node=1
    fi
    if [[ -z "$forced" && "$node" == 1 ]]; then
        renderer="$(timeout 3 glxinfo -B 2>/dev/null | awk -F': ' '/^OpenGL renderer string:/ && !seen { print $2; seen = 1 }' || true)"
    fi
    read -r path tier < <(gfx::decide "$node" "$renderer" "$(nproc 2>/dev/null || echo 1)" \
        "$(gfx::screen_pixels)" "$forced")
    case "${TURINGOS_GFX_TIER:-}" in
        full | lite | minimal) tier="$TURINGOS_GFX_TIER" ;;
    esac

    install -d -m700 "$run"
    printf 'GFX_PATH=%s\nGFX_TIER=%s\n' "$path" "$tier" > "${run}/gfx.env.tmp"
    mv "${run}/gfx.env.tmp" "${run}/gfx.env"
    cat "${run}/gfx.env"
    echo "turingos-gfx-detect: ${path}/${tier} (render node: ${node}, renderer: ${renderer:-none})" >&2
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    gfx::main "$@"
fi
