# /etc/xdg/openbox/autostart
# Runs when Openbox starts — launches the TuringOS UI in kiosk mode.

# ── System tray / compositor (lightweight, fast) ──────────────────────────────
tint2 &
picom --config /dev/null --backend xrender -b &

# ── Wallpaper ─────────────────────────────────────────────────────────────────
# Solid dark background; the UI covers the whole screen in kiosk mode
xsetroot -solid "#0a0a0f" &

# ── TuringOS UI ───────────────────────────────────────────────────────────────
# KIOSK=1 → fullscreen, no window chrome. Software rendering kicks in by
# itself when there's no GPU render node (VMs without 3D acceleration).
(
    sleep 1  # let the compositor settle before launching
    KIOSK=1 /usr/bin/turingos-ui
) &
