# /etc/xdg/openbox/autostart
# Runs when Openbox starts — launches the TuringOS UI in kiosk mode.

# ── Wallpaper ─────────────────────────────────────────────────────────────────
# Solid dark background, until the shell window covers the screen
xsetroot -solid "#0a0a0f" &

# ── Safe mode (boot menu "safe mode", kernel arg turingos.safe) ───────────────
# No agent, no UI: openbox, a panel and a terminal.
if grep -qw turingos.safe /proc/cmdline; then
    tint2 &
    x-terminal-emulator &
else
# ── TuringOS UI ───────────────────────────────────────────────────────────────
# turingosd (the desktop service, a systemd user unit) needs DISPLAY for the
# dock's apps, so it starts here rather than at login. The shell window is
# the page turingos-bridged-ws serves, in a Brave app window
# (turingos-kiosk); turingos-respawn restarts it after a crash and opens a
# terminal if it keeps crashing. Super+Esc opens a terminal any time.
# No panel and no compositor: the shell is the desktop, and a compositor
# costs a screen copy per frame on machines without a GPU.
(
    dbus-update-activation-environment --systemd DISPLAY XAUTHORITY 2>/dev/null \
        || systemctl --user import-environment DISPLAY XAUTHORITY
    systemctl --user restart turingosd.service
) &
turingos-respawn /usr/lib/turingos/session/turingos-kiosk &
fi
