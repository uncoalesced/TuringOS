# claudeos.list.chroot
# Explicit package list for ClaudeOS live image.
#
# Philosophy: install only what the demo needs.
# Trim hooks (0200/0300) clean up whatever the base profile drags in.
# Hooks (0400-0460) install gum, ClaudeOS scripts, Electron deps, and Claude CLI.

# ── Core system ───────────────────────────────────────────────────────────────
bash
bash-completion
coreutils
util-linux
procps
psmisc
less
grep
sed
gawk
findutils
diffutils
rsync
curl
wget
ca-certificates
gnupg
lsb-release

# ── Filesystem ────────────────────────────────────────────────────────────────
btrfs-progs
e2fsprogs
dosfstools
parted

# ── Networking ────────────────────────────────────────────────────────────────
network-manager
network-manager-gnome
iproute2
iputils-ping
dnsutils
openssh-client

# ── Display / Desktop (minimal — Openbox only, UI is fullscreen Electron) ─────
xorg
openbox
obconf
tint2
picom
nitrogen
lxappearance
x11-utils
x11-xserver-utils

# ── Terminal (for judges who want to poke around) ─────────────────────────────
rxvt-unicode
tmux
vim
nano

# ── System monitoring ─────────────────────────────────────────────────────────
htop
tree
file

# ── ClaudeOS runtime deps ─────────────────────────────────────────────────────
git
jq
fzf
zip
unzip
xclip
xsel
libnotify-bin

# ── Node.js (MCP tools + Electron fallback install) ───────────────────────────
nodejs
npm

# ── Python (MCP tools) ────────────────────────────────────────────────────────
python3
python3-pip
python3-venv

# ── Electron 44 system libraries ──────────────────────────────────────────────
# These are the native libs Electron (Chromium) links against.
# Hook 0450 installs these too — listing here ensures they're present
# even if the hook ordering changes.
libgtk-3-0
libgdk-pixbuf2.0-0
libcairo2
libpango-1.0-0
libpangocairo-1.0-0
libatk1.0-0
libatk-bridge2.0-0
libglib2.0-0
libx11-6
libxcomposite1
libxcursor1
libxdamage1
libxext6
libxfixes3
libxi6
libxrandr2
libxrender1
libxtst6
libxss1
libx11-xcb1
libxcb-dri3-0
libxcb1
libdrm2
libgbm1
libgl1
libgl1-mesa-dri
libglx-mesa0
libegl1
libegl-mesa0
libpulse0
libasound2
libnss3
libnspr4
libdbus-1-3
libexpat1
libfontconfig1
libfreetype6
libudev1
libatspi2.0-0
libcups2
libcap2

# ── Fonts ─────────────────────────────────────────────────────────────────────
fonts-dejavu-core
fonts-liberation
fonts-noto-core

# ── Live system plumbing ──────────────────────────────────────────────────────
live-boot
live-boot-initramfs-tools
live-config
live-config-systemd
systemd
systemd-sysv
dbus
udev
acpid

# ── Persistence ───────────────────────────────────────────────────────────────
cryptsetup
lvm2

# ── VM hardware support ───────────────────────────────────────────────────────
xserver-xorg-video-vmware
xserver-xorg-video-qxl
open-vm-tools
open-vm-tools-desktop
virtualbox-guest-utils
virtualbox-guest-x11
spice-vdagent

# ── Audio ─────────────────────────────────────────────────────────────────────
pulseaudio
pavucontrol

# ── Misc ──────────────────────────────────────────────────────────────────────
sudo
policykit-1
gvfs
shared-mime-info
xdg-utils
desktop-file-utils
