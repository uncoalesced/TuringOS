# turingos.list.chroot
# Explicit package list for the TuringOS live image (Debian 13 "trixie").
#
# Philosophy: install only what the image needs.
# Trim hooks (0200/0300) clean up whatever the base profile drags in.
# Hooks then add gum (0400) and Brave (0420, not in Debian; default browser
# with the Claude extension), build the desktop UI (0450), set up kiosk
# autologin (0470), install Homebrew (0490), set up the Calamares installer
# (0495), and install the Claude Code CLI + OpenCode (0500).

# ── Core system ───────────────────────────────────────────────────────────────
bash
bash-completion
coreutils
util-linux
procps
psmisc
less
grep
sed
gawk
findutils
diffutils
rsync
curl
ca-certificates
gnupg
lsb-release

# ── Filesystem ────────────────────────────────────────────────────────────────
btrfs-progs
e2fsprogs

# ── Networking ────────────────────────────────────────────────────────────────
network-manager
iproute2
iputils-ping
openssh-client

# ── Display (Wayland + X fallback) ────────────────────────────────────────────
# Wayland compositors for the trust model UI
cage
sway
labwc
wayland-protocols
# Wayland-native terminal for Super+Esc under sway/labwc (Phase 3 fallback)
foot

# X11 fallback (Openbox kiosk mode for live ISO compatibility)
xserver-xorg-core
xserver-xorg-input-libinput
xserver-xorg-video-fbdev
# vesa and vmware only exist for amd64/i386 in trixie — skipped on arm64
#if ARCHITECTURES amd64 i386
xserver-xorg-video-vesa
#endif
openbox
# The panel in safe mode only: otherwise the shell window is the desktop. No
# compositor: nothing needs one, and it costs a screen copy per frame in VMs.
tint2
x11-utils
x11-xserver-utils
xterm
lightdm
# A file manager for poking around the filesystem
thunar

# Sandbox & compositor tooling; xdotool also brings the shell forward on
# Super+Space (session/turingos-omni)
bubblewrap
xdotool
# Software OpenGL (llvmpipe) and the DRI drivers, named so they don't depend
# on what Brave happens to pull in; glxinfo tells the session which it got
libgl1-mesa-dri
mesa-utils

# ── Terminal tools ────────────────────────────────────────────────────────────
tmux
vim
nano
htop
tree
file

# ── TuringOS runtime deps ─────────────────────────────────────────────────────
git
jq
fzf
libnotify-bin

# ── turingosd runtime (built by hook 0450; voice input needs both) ───────────
# Listed explicitly so purging the build toolchain afterwards keeps them
libasound2t64
libgomp1

# ── Node.js (MCP tools, Claude Code / OpenCode npm fallback) ──────────────────
nodejs
npm

# ── Python (MCP tools via pipx, Wispr Flow voice backend venv) ───────────────
python3
python3-venv
pipx
python3-uvicorn
python3-fastapi
python3-aiofiles

# ── Fonts ─────────────────────────────────────────────────────────────────────
fonts-dejavu-core
fonts-liberation
fonts-noto-core

# ── Live system plumbing ──────────────────────────────────────────────────────
live-boot
live-boot-initramfs-tools
live-config
live-config-systemd
systemd
systemd-sysv
# The per-user systemd that runs turingosd and shell-helper
libpam-systemd
dbus-user-session
dbus
udev
acpid

# ── Installer (Calamares; hook 0495 brands it and adds turingos-install) ──────
calamares
calamares-settings-debian
qt6-qpa-plugins
# Everything the installed system's bootloader needs except grub-pc and
# grub-efi-amd64, which conflict: 0495 keeps those two as .debs
grub-common
grub2-common
#if ARCHITECTURES amd64
grub-pc-bin
grub-efi-amd64-bin
#endif
#if ARCHITECTURES arm64
grub-efi-arm64-bin
#endif
efibootmgr
ucf
cryptsetup-initramfs
keyutils

# ── Persistence ───────────────────────────────────────────────────────────────
cryptsetup
lvm2

# ── VM hardware support ───────────────────────────────────────────────────────
#if ARCHITECTURES amd64 i386
xserver-xorg-video-vmware
#endif
xserver-xorg-video-qxl
open-vm-tools
open-vm-tools-desktop
spice-vdagent

# ── Audio (microphone for voice input) ────────────────────────────────────────
pulseaudio

# ── Misc ──────────────────────────────────────────────────────────────────────
sudo
polkitd
pkexec
gvfs
shared-mime-info
xdg-utils
desktop-file-utils
# The dock's Settings button (Qt is already here for Calamares)
lxqt-config
# hwclock (moved out of util-linux in trixie); Calamares sets the RTC with it
util-linux-extra
