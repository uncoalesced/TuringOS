# turingos.list.chroot
# Explicit package list for the TuringOS live image (Debian 13 "trixie").
#
# Philosophy: install only what the image needs.
# Trim hooks (0200/0300) clean up whatever the base profile drags in.
# Hooks then add gum (0400), build the desktop UI (0450), set up kiosk
# autologin (0470) and install the Claude Code CLI + OpenCode (0500).

# ── Core system ───────────────────────────────────────────────────────────────
bash
bash-completion
coreutils
util-linux
procps
psmisc
less
grep
sed
gawk
findutils
diffutils
rsync
curl
ca-certificates
gnupg
lsb-release

# ── Filesystem ────────────────────────────────────────────────────────────────
btrfs-progs
e2fsprogs

# ── Networking ────────────────────────────────────────────────────────────────
network-manager
iproute2
iputils-ping
openssh-client

# ── Display (Openbox only; the UI is a fullscreen Tauri window) ──────────────
# Explicit X pieces instead of the `xorg` metapackage, which pulls in every
# video driver for 0200 to purge again. modesetting is in xserver-xorg-core.
xserver-xorg-core
xserver-xorg-input-libinput
xserver-xorg-video-fbdev
xserver-xorg-video-vesa
openbox
tint2
picom
x11-utils
x11-xserver-utils
xterm
lightdm
# A file manager for poking around the filesystem
thunar

# ── Terminal tools ────────────────────────────────────────────────────────────
tmux
vim
nano
htop
tree
file

# ── TuringOS runtime deps ─────────────────────────────────────────────────────
git
jq
fzf
libnotify-bin

# ── Desktop UI runtime (turingos-ui, built by hook 0450) ─────────────────────
# Listed explicitly so purging the build toolchain afterwards keeps them
libwebkit2gtk-4.1-0
libgtk-3-0t64
libasound2t64
libxdo3
libgomp1
gstreamer1.0-plugins-base

# ── Node.js (MCP tools, Claude Code / OpenCode npm fallback) ──────────────────
nodejs
npm

# ── Python (MCP tools via pipx, Wispr Flow voice backend venv) ───────────────
python3
python3-venv
pipx

# ── Fonts ─────────────────────────────────────────────────────────────────────
fonts-dejavu-core
fonts-liberation
fonts-noto-core

# ── Live system plumbing ──────────────────────────────────────────────────────
live-boot
live-boot-initramfs-tools
live-config
live-config-systemd
systemd
systemd-sysv
dbus
udev
acpid

# ── Persistence ───────────────────────────────────────────────────────────────
cryptsetup
lvm2

# ── VM hardware support ───────────────────────────────────────────────────────
xserver-xorg-video-vmware
xserver-xorg-video-qxl
open-vm-tools
open-vm-tools-desktop
spice-vdagent

# ── Audio (microphone for voice input) ────────────────────────────────────────
pulseaudio

# ── Misc ──────────────────────────────────────────────────────────────────────
sudo
polkitd
pkexec
gvfs
shared-mime-info
xdg-utils
desktop-file-utils
