# installer.list.binary
# Not installed in the live system: live-build puts these (and their
# dependencies) in the ISO's package pool. Calamares' sources-media job
# points the target at that pool, so its bootloader-config step can install
# GRUB without network (grub-efi on UEFI, grub-pc on BIOS, cryptsetup bits
# for encrypted installs).
grub-pc
grub-efi
grub-efi-amd64
cryptsetup-initramfs
keyutils
