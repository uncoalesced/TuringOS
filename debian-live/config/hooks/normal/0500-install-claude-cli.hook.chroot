#!/bin/bash
# 0500-install-claude-cli.hook.chroot
#
# Installs the agent CLIs into the live image:
#   - Claude Code: Anthropic's native installer, npm as fallback
#   - OpenCode: runs agents on non-Claude providers (nvidia, ollama,
#     openrouter, custom), pinned so the image is reproducible
# and a one-time API-key prompt for the first interactive login.
#
# API keys can't be set at build time (they're per-user). Without network
# the CLIs are skipped; `turingos init` offers to install Claude Code later.

set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

OPENCODE_VERSION="1.18.34"

# ─── Claude Code ──────────────────────────────────────────────────────────────

_install_claude_native() {
    echo "==> Trying Anthropic's native installer..."
    curl -fsSL https://claude.ai/install.sh | bash || return 1
    # As root it lands in /root/.local; move the real binary system-wide
    local bin
    bin=$(readlink -f /root/.local/bin/claude 2>/dev/null) || return 1
    [[ -x "$bin" ]] || return 1
    install -m755 "$bin" /usr/local/bin/claude
    rm -rf /root/.local/bin/claude /root/.local/share/claude
}

_install_claude_npm() {
    echo "==> Falling back to npm..."
    npm install -g --prefix /usr/local @anthropic-ai/claude-code
}

# ─── First-login API key prompt ───────────────────────────────────────────────

_write_firstboot_prompt() {
    cat > /etc/profile.d/turingos-apikey.sh <<'APIKEY_HOOK'
# /etc/profile.d/turingos-apikey.sh
# Asks for ANTHROPIC_API_KEY once, on the first interactive login.
# Sourced: no shebang, no set -e.

[[ $- == *i* ]] || return 0
command -v claude &>/dev/null || return 0
[[ -f "${HOME}/.turingos/.apikey-configured" ]] && return 0

if [[ -z "${ANTHROPIC_API_KEY:-}" ]] && ! grep -q '^ANTHROPIC_API_KEY=' "${HOME}/.turingos/config.env" 2>/dev/null; then
    # Saves to ~/.turingos/config.env (mode 600)
    bash /usr/lib/turingos/pkg/turingos-install-claude-cli.sh --api-key
fi
mkdir -p "${HOME}/.turingos"
touch "${HOME}/.turingos/.apikey-configured"
APIKEY_HOOK
    chmod 644 /etc/profile.d/turingos-apikey.sh
}

# ─── Run ──────────────────────────────────────────────────────────────────────

_write_firstboot_prompt

if ! curl -fsSI --max-time 10 https://claude.ai >/dev/null 2>&1; then
    echo "==> [0500-install-claude-cli] No network: skipping Claude Code and OpenCode."
    echo "    Users can install Claude Code later with: turingos init"
    exit 0
fi

echo "==> [0500-install-claude-cli] Installing Claude Code CLI..."
if _install_claude_native || _install_claude_npm; then
    echo "==> Claude Code: $(claude --version 2>/dev/null || echo installed)"
else
    echo "==> WARNING: Claude Code CLI not installed; users can run: turingos init"
fi

echo "==> [0500-install-claude-cli] Installing OpenCode ${OPENCODE_VERSION}..."
if npm install -g --prefix /usr/local "opencode-ai@${OPENCODE_VERSION}"; then
    echo "==> OpenCode: $(opencode --version 2>/dev/null || echo installed)"
else
    echo "==> WARNING: OpenCode not installed; non-Claude providers won't start agents"
fi

npm cache clean --force >/dev/null 2>&1 || true
rm -rf /root/.npm
apt-get clean

echo "==> [0500-install-claude-cli] Done. Chroot size: $(du -sh / --exclude=/proc --exclude=/sys 2>/dev/null | cut -f1)"
