#!/bin/bash
# 0450-build-daemon.hook.chroot
#
# Builds turingosd (daemon/), the desktop service behind turingos-bridged-ws,
# inside the chroot, so the binary links against exactly this image's Debian
# libraries, installs it as /usr/bin/turingosd, then removes the toolchain and
# the source. The page is plain files (sync-scripts.sh stages it into
# /usr/lib/turingos/ui/web); nothing of the page is built here.
#
# Runtime libraries (ALSA, libgomp) are in the package list, so purging the
# -dev packages below keeps them. The ldd check at the end fails the build if
# that ever stops being true.
#
# Toolchain: rustc-web/cargo-web, Debian 13's security-updated Rust (the one
# Firefox/Chromium build with). Plain rustc 1.85 is below the crate's
# rust-version. Needs network: cargo fetches crates (pinned by Cargo.lock).

set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

SRC=/opt/turingosd-src
UI=/usr/lib/turingos/ui/web
BUILD_DEPS=(cargo-web rustc-web build-essential pkg-config cmake clang libclang-dev
    libasound2-dev)

for path in "${SRC}/Cargo.lock" "${UI}/index.html" "${UI}/boot.js"; do
    if [[ ! -e "$path" ]]; then
        echo "ERROR: $path missing. Run debian-live/sync-scripts.sh before lb build."
        exit 1
    fi
done

echo "==> [0450-build-daemon] Installing build dependencies..."
apt-get install -y --no-install-recommends "${BUILD_DEPS[@]}"

echo "==> [0450-build-daemon] Building turingosd ($(rustc --version))..."
export CARGO_HOME=/tmp/turingos-cargo CARGO_TARGET_DIR=/tmp/turingosd-target
cargo build --release --locked --manifest-path "${SRC}/Cargo.toml"
install -m755 "${CARGO_TARGET_DIR}/release/turingosd" /usr/bin/turingosd

echo "==> [0450-build-daemon] Removing toolchain and sources..."
rm -rf "$SRC" "$CARGO_HOME" "$CARGO_TARGET_DIR"
apt-get purge -y --auto-remove "${BUILD_DEPS[@]}"
apt-get clean

if ldd /usr/bin/turingosd | grep 'not found'; then
    echo "ERROR: turingosd is missing runtime libraries (add them to turingos.list.chroot)"
    exit 1
fi

echo "==> [0450-build-daemon] Done. Chroot size: $(du -sh / --exclude=/proc --exclude=/sys 2>/dev/null | cut -f1)"
