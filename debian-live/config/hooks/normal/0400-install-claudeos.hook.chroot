#!/bin/bash
# 0400-install-claudeos.hook.chroot
#
# Installs ClaudeOS runtime dependencies via apt, then wires up the scripts
# that were baked into the image via config/includes.chroot/opt/claudeos/.
#
# Script source path in chroot build:
#   config/includes.chroot/opt/claudeos/  →  /opt/claudeos/  (inside chroot)
#
# Final installed layout:
#   /usr/bin/claudeos                 ← symlink to /opt/claudeos/claudeos
#   /usr/lib/claudeos/                ← module tree (sourced at runtime)
#   /usr/share/doc/claudeos/          ← docs
#   /usr/share/licenses/claudeos/     ← LICENSE
#   /etc/profile.d/claudeos-first-run.sh

set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

echo "==> [0400-install-claudeos] Installing ClaudeOS dependencies..."

# ─── Runtime deps (Debian package names) ─────────────────────────────────────
apt-get install -y \
    git \
    jq \
    curl \
    rsync \
    btrfs-progs \
    libnotify-bin \
    fzf \
    bash-completion

# gum is not in Debian repos — install via its official apt source
if ! command -v gum &>/dev/null; then
    echo "==> [0400-install-claudeos] Installing gum (Charm)..."
    mkdir -p /etc/apt/keyrings
    curl -fsSL https://repo.charm.sh/apt/gpg.key \
        | gpg --dearmor -o /etc/apt/keyrings/charm.gpg
    echo "deb [signed-by=/etc/apt/keyrings/charm.gpg] https://repo.charm.sh/apt/ * *" \
        > /etc/apt/sources.list.d/charm.list
    apt-get update -qq
    apt-get install -y gum
fi

echo "==> [0400-install-claudeos] Wiring ClaudeOS scripts..."

# ─── Verify source exists ─────────────────────────────────────────────────────
CLAUDEOS_SRC="/opt/claudeos"

if [[ ! -d "$CLAUDEOS_SRC" ]]; then
    echo "ERROR: $CLAUDEOS_SRC not found in chroot."
    echo "Make sure config/includes.chroot/opt/claudeos/ exists and contains the scripts."
    exit 1
fi

# ─── Install module tree to /usr/lib/claudeos/ ───────────────────────────────
install -d /usr/lib/claudeos/core
install -d /usr/lib/claudeos/agent
install -d /usr/lib/claudeos/sandbox
install -d /usr/lib/claudeos/bazaar
install -d /usr/lib/claudeos/game
install -d /usr/lib/claudeos/monitor
install -d /usr/lib/claudeos/pkg

install -m644 "${CLAUDEOS_SRC}/core/config.sh"    /usr/lib/claudeos/core/
install -m644 "${CLAUDEOS_SRC}/core/ui.sh"         /usr/lib/claudeos/core/
install -m644 "${CLAUDEOS_SRC}/core/logging.sh"    /usr/lib/claudeos/core/

install -m644 "${CLAUDEOS_SRC}/agent/claude.sh"    /usr/lib/claudeos/agent/

install -m644 "${CLAUDEOS_SRC}/sandbox/btrfs.sh"   /usr/lib/claudeos/sandbox/
install -m644 "${CLAUDEOS_SRC}/sandbox/diff.sh"    /usr/lib/claudeos/sandbox/

install -m644 "${CLAUDEOS_SRC}/bazaar/registry.sh"   /usr/lib/claudeos/bazaar/
install -m644 "${CLAUDEOS_SRC}/bazaar/install.sh"    /usr/lib/claudeos/bazaar/
install -m644 "${CLAUDEOS_SRC}/bazaar/registry.json" /usr/lib/claudeos/bazaar/

install -m644 "${CLAUDEOS_SRC}/game/gamemode.sh"   /usr/lib/claudeos/game/

install -m644 "${CLAUDEOS_SRC}/monitor/system.sh"  /usr/lib/claudeos/monitor/

install -m755 "${CLAUDEOS_SRC}/pkg/claudeos-install-claude-cli.sh" \
    /usr/lib/claudeos/pkg/

# ─── Main executable → /usr/bin/ ─────────────────────────────────────────────
install -m755 "${CLAUDEOS_SRC}/claudeos" /usr/bin/claudeos

# ─── License ──────────────────────────────────────────────────────────────────
install -d /usr/share/licenses/claudeos
install -m644 "${CLAUDEOS_SRC}/LICENSE" /usr/share/licenses/claudeos/

# ─── Docs ─────────────────────────────────────────────────────────────────────
install -d /usr/share/doc/claudeos
for doc in WORKFLOW.md plan.md pkg/ISO_BUILD.md pkg/DEBIAN_BUILD.md; do
    [[ -f "${CLAUDEOS_SRC}/${doc}" ]] && \
        install -m644 "${CLAUDEOS_SRC}/${doc}" /usr/share/doc/claudeos/
done

# ─── Profile.d first-run hook ─────────────────────────────────────────────────
install -m644 "${CLAUDEOS_SRC}/pkg/claudeos-first-run.sh" \
    /etc/profile.d/claudeos-first-run.sh

# ─── Persistence dir for ~/.claudeos ─────────────────────────────────────────
# Create the skeleton so it exists in the default user's home on first boot.
# live-build creates user 'user' by default — adjust if you've changed this.
LIVE_USER_HOME="/etc/skel"
mkdir -p "${LIVE_USER_HOME}/.claudeos/logs"
mkdir -p "${LIVE_USER_HOME}/.claudeos/sandboxes"
mkdir -p "${LIVE_USER_HOME}/.claudeos/bazaar"
mkdir -p "${LIVE_USER_HOME}/.claudeos/pids"

# Write a default config.env so first run has sensible defaults
cat > "${LIVE_USER_HOME}/.claudeos/config.env" <<'EOF'
# ClaudeOS configuration
# Set your Anthropic API key here or export ANTHROPIC_API_KEY in your shell
# ANTHROPIC_API_KEY=sk-ant-...

CLAUDEOS_AGENT_BINARY=claude
CLAUDEOS_SANDBOX_BACKEND=btrfs
CLAUDEOS_GAME_RENICE_LEVEL=10
CLAUDEOS_LOG_LEVEL=info
EOF

# ─── Desktop entry (optional — puts claudeos in app launcher) ─────────────────
install -d /usr/share/applications
cat > /usr/share/applications/claudeos.desktop <<'EOF'
[Desktop Entry]
Name=ClaudeOS Dashboard
Comment=Agentic layer — Btrfs sandboxing, MCP registry, Game Mode
Exec=bash -c 'claudeos dashboard'
Terminal=true
Type=Application
Categories=Development;
Keywords=claude;agent;ai;sandbox;
EOF

# ─── Verify install ───────────────────────────────────────────────────────────
echo ""
echo "==> [0400-install-claudeos] Verifying install..."
if command -v claudeos &>/dev/null; then
    claudeos version
    echo "==> [0400-install-claudeos] ClaudeOS installed successfully."
else
    echo "ERROR: claudeos not found in PATH after install"
    exit 1
fi

echo "==> [0400-install-claudeos] Chroot size: $(du -sh / --exclude=/proc --exclude=/sys 2>/dev/null | cut -f1)"
