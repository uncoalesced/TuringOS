#!/bin/bash
# 0475-fallback.hook.chroot
#
# Phase 3 fallback: Super+Esc opens a plain terminal in the openbox session,
# whatever state the TuringOS UI or the agent is in.
#
# Also the rest of what the openbox session needs from rc.xml:
#   Super+Space   bring the shell forward and open its command bar
#                 (/usr/lib/turingos/session/turingos-omni)
#   the shell     the Brave app window turingos-kiosk opens (class
#                 turingos-shell) is the desktop: no frame, the whole
#                 screen, on every desktop, below every other window
#
# Patches the openbox package's /etc/xdg/openbox/rc.xml in place instead of
# shipping a whole copy over the conffile. (sway and labwc get the same key in
# includes.chroot/etc/turingos/; safe mode is in the openbox autostart.)

set -euo pipefail

RC="${OPENBOX_RC:-/etc/xdg/openbox/rc.xml}"

echo "==> [0475-fallback] Super+Esc, Super+Space and the shell window in ${RC}..."

if [[ ! -f "$RC" ]]; then
    echo "ERROR: [0475-fallback] ${RC} missing (is openbox installed?)" >&2
    exit 1
fi

if ! grep -q '<keyboard>' "$RC"; then
    echo "ERROR: [0475-fallback] no <keyboard> section in ${RC}" >&2
    exit 1
fi

# First in <keyboard>: openbox keeps the first binding of a key
if ! grep -q 'key="W-Escape"' "$RC"; then
    sed -i '0,/<keyboard>/s|<keyboard>|<keyboard>\n    <keybind key="W-Escape">\n      <action name="Execute"><command>x-terminal-emulator</command></action>\n    </keybind>|' "$RC"
fi
if ! grep -q '/usr/lib/turingos/session/turingos-omni' "$RC"; then
    sed -i '0,/<keyboard>/s|<keyboard>|<keyboard>\n    <keybind key="W-space">\n      <action name="Execute"><command>/usr/lib/turingos/session/turingos-omni</command></action>\n    </keybind>|' "$RC"
fi

SHELL_RULE='    <application class="turingos-shell" type="normal">\n      <decor>no</decor>\n      <maximized>true</maximized>\n      <layer>below</layer>\n      <desktop>all</desktop>\n      <focus>yes</focus>\n    </application>'
if ! grep -q 'class="turingos-shell"' "$RC"; then
    if grep -q '</applications>' "$RC"; then
        sed -i "0,/<\/applications>/s|</applications>|${SHELL_RULE}\n  </applications>|" "$RC"
    else
        sed -i "s|</openbox_config>|  <applications>\n${SHELL_RULE}\n  </applications>\n</openbox_config>|" "$RC"
    fi
fi

for needle in 'key="W-Escape"' '/usr/lib/turingos/session/turingos-omni' 'class="turingos-shell"'; do
    grep -q "$needle" "$RC" || { echo "ERROR: [0475-fallback] ${needle} not added" >&2; exit 1; }
done

echo "==> [0475-fallback] Done."
