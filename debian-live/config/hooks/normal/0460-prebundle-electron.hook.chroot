#!/bin/bash
# 0460-prebundle-electron.hook.chroot
#
# Pre-bundles Electron into /opt/turingos-ui/node_modules/ at build time
# so the UI launches without internet access on first boot (Option A).
#
# What this does:
#   1. Runs npm install in /opt/turingos-ui/
#   2. Electron's npm postinstall downloads the platform binary (~100-150MB)
#   3. Sets correct permissions so the live user can run it
#   4. Wires /usr/local/bin/turingos-ui as a convenience launcher
#
# Requires: nodejs, npm (from package list), Electron deps (from 0450)
# Requires: /opt/turingos-ui/ populated by includes.chroot + sync-scripts.sh

set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

UI_DIR="/opt/turingos-ui"

echo "==> [0460-prebundle-electron] Pre-bundling Electron UI..."

# ── Verify UI source is present ───────────────────────────────────────────────
if [[ ! -f "${UI_DIR}/package.json" ]]; then
    echo "ERROR: ${UI_DIR}/package.json not found."
    echo "Run sync-scripts.sh before lb build to copy ui/ into includes.chroot/"
    exit 1
fi

echo "==> UI source: ${UI_DIR}"
echo "==> package.json contents:"
cat "${UI_DIR}/package.json"
echo ""

# ── Set npm cache to a temp dir so it doesn't persist in the image ────────────
export npm_config_cache="/tmp/npm-cache-electron"
mkdir -p "$npm_config_cache"

# ── Run npm install ───────────────────────────────────────────────────────────
echo "==> [0460-prebundle-electron] Running npm install (downloads Electron ~150MB)..."
cd "${UI_DIR}"

npm install \
    --no-audit \
    --no-fund \
    --prefer-offline=false

echo "==> [0460-prebundle-electron] npm install complete."

# ── Verify Electron binary exists ─────────────────────────────────────────────
ELECTRON_BIN="${UI_DIR}/node_modules/.bin/electron"

if [[ ! -x "$ELECTRON_BIN" ]]; then
    # Try the direct path (Electron installs its binary differently on Linux)
    ELECTRON_BIN_ALT=$(find "${UI_DIR}/node_modules" -name "electron" -type f -perm /111 2>/dev/null | head -1)
    if [[ -n "$ELECTRON_BIN_ALT" ]]; then
        ELECTRON_BIN="$ELECTRON_BIN_ALT"
        echo "==> Found Electron at: ${ELECTRON_BIN}"
    else
        echo "ERROR: Electron binary not found after npm install."
        echo "Contents of node_modules/.bin/:"
        ls "${UI_DIR}/node_modules/.bin/" 2>/dev/null || echo "(empty)"
        exit 1
    fi
fi

echo "==> Electron binary: ${ELECTRON_BIN}"
echo "==> Electron version: $("${ELECTRON_BIN}" --version 2>/dev/null || echo 'unknown')"

# ── Set permissions ───────────────────────────────────────────────────────────
# The live user (default: 'user') needs to own and execute the UI directory.
# live-build runs hooks as root inside the chroot. We set world-readable
# permissions so any user can run it — the live user is created later.

chmod -R a+rX "${UI_DIR}"
chmod +x "${UI_DIR}/run.sh"

# Chrome-sandbox needs to be owned by root and have setuid bit for the
# Electron sandbox to work properly (alternative is --no-sandbox in run.sh,
# which run.sh already handles as a fallback).
CHROME_SANDBOX=$(find "${UI_DIR}/node_modules" -name "chrome-sandbox" -type f 2>/dev/null | head -1)
if [[ -n "$CHROME_SANDBOX" ]]; then
    chown root:root "$CHROME_SANDBOX"
    chmod 4755 "$CHROME_SANDBOX"
    echo "==> chrome-sandbox: setuid root applied"
fi

# ── System-wide launcher ──────────────────────────────────────────────────────
# This is what 'turingos ui' calls and what the autostart script uses.
cat > /usr/local/bin/turingos-ui <<'LAUNCHER'
#!/usr/bin/env bash
# /usr/local/bin/turingos-ui
# Launches the TuringOS Electron UI.
# Wrapper so the UI can be launched from autostart, dock, or terminal.

UI_DIR="/opt/turingos-ui"

if [[ ! -f "${UI_DIR}/package.json" ]]; then
    echo "TuringOS UI not found at ${UI_DIR}" >&2
    exit 1
fi

exec "${UI_DIR}/run.sh" "$@"
LAUNCHER
chmod +x /usr/local/bin/turingos-ui

# ── Wire 'turingos ui' subcommand ─────────────────────────────────────────────
# The turingos entrypoint already has a router. We add a ui subcommand handler
# by dropping a small override file that the entrypoint sources if present.
cat > /usr/lib/turingos/ui.sh <<'UI_HANDLER'
#!/usr/bin/env bash
# /usr/lib/turingos/ui.sh
# Sourced by the turingos entrypoint for the 'ui' subcommand.

ui::launch() {
    exec /usr/local/bin/turingos-ui "$@"
}
UI_HANDLER
chmod 644 /usr/lib/turingos/ui.sh

# ── Clean up npm cache ────────────────────────────────────────────────────────
rm -rf "$npm_config_cache"
apt-get clean

echo ""
echo "==> [0460-prebundle-electron] Electron pre-bundled successfully."
echo "==> UI size: $(du -sh "${UI_DIR}" | cut -f1)"
echo "==> Chroot size: $(du -sh / --exclude=/proc --exclude=/sys 2>/dev/null | cut -f1)"
