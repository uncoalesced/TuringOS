#!/bin/bash
# 0300-locale-trim.hook.chroot
# Purge locale data, man pages, and doc directories.
# Keeps: en_US.UTF-8, en_GB.UTF-8 (safe for demo audiences).
# Expected savings: 150–300MB
#
# Runs AFTER 0200-trim, BEFORE turingos install hooks.

set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

echo "==> [0300-locale-trim] Starting locale and doc purge..."

# ─── 1. Locale purge via localepurge ─────────────────────────────────────────
# localepurge removes all locale data except the ones you configure.

apt-get install -y localepurge

# Configure which locales to keep
cat > /etc/locale.nopurge <<'EOF'
MANDELETE
DONTBOTHERNEWLOCALE
SHOWFREEDSPACE
en
en_US
en_US.UTF-8
en_GB
en_GB.UTF-8
EOF

# Run it
localepurge

# ─── 2. Remove /usr/share/doc ─────────────────────────────────────────────────
# Debian packages install docs here. Useless in a live demo image.
# Keep copyright files — required by Debian policy even in live images.

echo "==> [0300-locale-trim] Stripping /usr/share/doc..."
find /usr/share/doc -depth -not -name "copyright" -not -path "/usr/share/doc" \
    -delete 2>/dev/null || true

# ─── 3. Remove /usr/share/man ─────────────────────────────────────────────────
# Man pages — not needed in a demo image.
# TuringOS has its own help system via 'turingos help'.

echo "==> [0300-locale-trim] Stripping /usr/share/man..."
find /usr/share/man -type f -delete 2>/dev/null || true
find /usr/share/man -type d -empty -delete 2>/dev/null || true

# ─── 4. Remove /usr/share/info ───────────────────────────────────────────────
find /usr/share/info -type f -delete 2>/dev/null || true

# ─── 5. Remove /usr/share/locale (residual after localepurge) ────────────────
# localepurge handles most of this, but some packages install LC_MESSAGES
# outside the standard path. Belt-and-suspenders cleanup:

echo "==> [0300-locale-trim] Cleaning residual locale dirs..."
for locale_dir in /usr/share/locale/*/; do
    locale_name=$(basename "$locale_dir")
    # Keep English variants
    case "$locale_name" in
        en|en_US|en_GB|en_US.UTF-8|en_GB.UTF-8|C|POSIX) continue ;;
    esac
    rm -rf "$locale_dir"
done

# ─── 6. Strip /usr/share/i18n/locales except en_* ────────────────────────────
find /usr/share/i18n/locales -type f \
    ! -name 'en_US' ! -name 'en_GB' ! -name 'en_*' \
    ! -name 'i18n' ! -name 'iso14651_t1*' ! -name 'translit_*' \
    -delete 2>/dev/null || true

# ─── 7. apt cache clean ───────────────────────────────────────────────────────
apt-get clean
rm -rf /var/lib/apt/lists/*

# Re-fetch minimal apt lists so subsequent hooks can still install packages
apt-get update -qq

# ─── 8. Remove bash completion for packages we've purged ─────────────────────
# Minor but adds up
find /usr/share/bash-completion/completions -type f \
    \( -name 'libreoffice' -o -name 'cups*' -o -name 'bluetooth*' \
       -o -name 'thunderbird' -o -name 'gimp' \) \
    -delete 2>/dev/null || true

# ─── 9. Compress remaining man pages that survive (from keep list) ────────────
# Nothing should survive the man purge above, but if something is regenerated
# by a subsequent hook, gzip it.
find /usr/share/man -type f -name '*.1' -o -name '*.8' 2>/dev/null \
    | xargs -r gzip -9 2>/dev/null || true

echo "==> [0300-locale-trim] Done. Chroot size: $(du -sh / --exclude=/proc --exclude=/sys 2>/dev/null | cut -f1)"
