#!/bin/bash
# 0480-install-brave.hook.chroot
#
# Installs Brave as the system browser. `claude` /login, the Anthropic
# console (API keys), Google sign-in and every link in the UI go through
# xdg-open / x-www-browser / $BROWSER, so all three point at Brave.
# Brave (not Firefox) because Claude in Chrome needs a Chromium browser.
# The Claude extension is force-installed by managed policy on first
# launch with network; Claude Code finds it in Brave by itself (`--chrome`).
#
# Unlike the agent CLIs (0500), no network fails the build: an image
# without a browser can't sign in to anything.

set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

KEYRING=/usr/share/keyrings/brave-browser-archive-keyring.gpg
CLAUDE_EXTENSION=fcoeoabgfenejglbffodgkkbkcdhcgfn

echo "==> [0480-install-brave] Adding the Brave apt repository..."
curl -fsSL --retry 3 --retry-all-errors -o "$KEYRING" \
    https://brave-browser-apt-release.s3.brave.com/brave-browser-archive-keyring.gpg
echo "deb [signed-by=${KEYRING} arch=amd64] https://brave-browser-apt-release.s3.brave.com/ stable main" \
    > /etc/apt/sources.list.d/brave-browser-release.list

# 0300 deleted the apt lists
apt-get update -qq
apt-get install -y --no-install-recommends brave-browser

# ─── Default browser ──────────────────────────────────────────────────────────

update-alternatives --set x-www-browser /usr/bin/brave-browser-stable
update-alternatives --set gnome-www-browser /usr/bin/brave-browser-stable

# xdg-open has no desktop environment to ask under openbox: it reads this
cat > /etc/xdg/mimeapps.list <<'EOF'
[Default Applications]
x-scheme-handler/http=brave-browser.desktop
x-scheme-handler/https=brave-browser.desktop
text/html=brave-browser.desktop
EOF

# Claude Code and other CLIs honor $BROWSER; pam_env sets it for every login
grep -q '^BROWSER=' /etc/environment 2>/dev/null || echo 'BROWSER=brave-browser' >> /etc/environment

# ─── Policy ───────────────────────────────────────────────────────────────────
# Claude extension installed and pinned to the toolbar. Claude is the
# assistant here, so Leo is off, along with the crypto, VPN, news and call
# buttons that crowd the toolbar, and the default-browser and crash-report
# prompts. Names checked against the strings in Brave 1.96's binary.

mkdir -p /etc/brave/policies/managed
cat > /etc/brave/policies/managed/turingos.json <<EOF
{
  "ExtensionInstallForcelist": [
    "${CLAUDE_EXTENSION};https://clients2.google.com/service/update2/crx"
  ],
  "ExtensionSettings": {
    "${CLAUDE_EXTENSION}": { "toolbar_pin": "force_pinned" }
  },
  "BraveAIChatEnabled": false,
  "BraveRewardsDisabled": true,
  "BraveWalletDisabled": true,
  "BraveVPNDisabled": true,
  "BraveNewsDisabled": true,
  "BraveTalkDisabled": true,
  "DefaultBrowserSettingEnabled": false,
  "MetricsReportingEnabled": false
}
EOF
python3 -m json.tool /etc/brave/policies/managed/turingos.json >/dev/null

[[ "$(readlink -f /etc/alternatives/x-www-browser)" == /opt/brave.com/* ]] \
    || { echo "ERROR: x-www-browser doesn't resolve to Brave"; exit 1; }

apt-get clean
rm -rf /var/lib/apt/lists/*

echo "==> [0480-install-brave] $(brave-browser --version 2>/dev/null || echo 'Brave installed')"
echo "==> [0480-install-brave] Done. Chroot size: $(du -sh / --exclude=/proc --exclude=/sys 2>/dev/null | cut -f1)"
