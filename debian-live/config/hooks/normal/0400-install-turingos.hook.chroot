#!/bin/bash
# 0400-install-turingos.hook.chroot
#
# The TuringOS install itself is staged by ../../sync-scripts.sh into
# config/includes.chroot (live-build copies it in before hooks run):
#   /usr/bin/turingos -> /usr/lib/turingos/turingos, /usr/lib/turingos/,
#   /etc/profile.d/turingos-first-run.sh, /usr/share/doc/turingos/
# Runtime packages come from package-lists/turingos.list.chroot.
#
# This hook adds what can't be staged as files: gum (Charm's apt repo), the
# app-launcher entry, and a check that the install actually runs.

set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

echo "==> [0400-install-turingos] Checking staged install..."
for path in /usr/bin/turingos /usr/lib/turingos/core/config.sh /usr/lib/turingos/bazaar/registry.json; do
    if [[ ! -e "$path" ]]; then
        echo "ERROR: $path missing. Run debian-live/sync-scripts.sh before lb build."
        exit 1
    fi
done

# ─── gum: not in Debian, install from Charm's signed apt repo ────────────────
if ! command -v gum &>/dev/null; then
    echo "==> [0400-install-turingos] Installing gum (Charm)..."
    install -d -m755 /etc/apt/keyrings
    curl -fsSL --retry 3 --retry-all-errors https://repo.charm.sh/apt/gpg.key | gpg --dearmor -o /etc/apt/keyrings/charm.gpg
    echo "deb [signed-by=/etc/apt/keyrings/charm.gpg] https://repo.charm.sh/apt/ * *" \
        > /etc/apt/sources.list.d/charm.list
    apt-get update -qq
    apt-get install -y gum
fi

# ─── App launcher entry ───────────────────────────────────────────────────────
install -d /usr/share/applications
cat > /usr/share/applications/turingos.desktop <<'EOF'
[Desktop Entry]
Name=TuringOS Dashboard
Comment=Agentic layer — Btrfs sandboxing, MCP registry, Game Mode
Exec=turingos dashboard
Terminal=true
Type=Application
Categories=Development;
Keywords=claude;agent;ai;sandbox;
EOF

# ─── Verify ───────────────────────────────────────────────────────────────────
# Proves every module sources cleanly from the installed layout
HOME=/tmp/turingos-verify turingos version
rm -rf /tmp/turingos-verify
apt-get clean

echo "==> [0400-install-turingos] Done. Chroot size: $(du -sh / --exclude=/proc --exclude=/sys 2>/dev/null | cut -f1)"
