#!/bin/bash
# 0450-build-ui.hook.chroot
#
# Builds the TuringOS desktop UI (Tauri, ui/src-tauri) inside the chroot, so
# the binary links against exactly this image's Debian libraries, installs it
# as /usr/bin/turingos-ui, then removes the toolchain and the source.
#
# Runtime libraries (WebKitGTK, ALSA, libxdo, libgomp) are in the package
# list, so purging the -dev packages below keeps them. The ldd check at the
# end fails the build if that ever stops being true.
#
# Toolchain: rustc-web/cargo-web, Debian 13's security-updated Rust (the one
# Firefox/Chromium build with). Plain rustc 1.85 is below the crate's
# rust-version. Needs network: cargo fetches crates (pinned by Cargo.lock).

set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

SRC=/opt/turingos-ui
BUILD_DEPS=(cargo-web rustc-web build-essential pkg-config cmake clang libclang-dev
    libwebkit2gtk-4.1-dev libasound2-dev libxdo-dev)

echo "==> [0450-build-ui] Installing build dependencies..."
apt-get install -y --no-install-recommends "${BUILD_DEPS[@]}"

echo "==> [0450-build-ui] Building turingos-ui ($(rustc --version))..."
export CARGO_HOME=/tmp/turingos-cargo CARGO_TARGET_DIR=/tmp/turingos-ui-target
cargo build --release --locked --manifest-path "${SRC}/src-tauri/Cargo.toml"
install -m755 "${CARGO_TARGET_DIR}/release/turingos-ui" /usr/bin/turingos-ui

echo "==> [0450-build-ui] Removing toolchain and sources..."
rm -rf "$SRC" "$CARGO_HOME" "$CARGO_TARGET_DIR"
apt-get purge -y --auto-remove "${BUILD_DEPS[@]}"
apt-get clean

if ldd /usr/bin/turingos-ui | grep 'not found'; then
    echo "ERROR: turingos-ui is missing runtime libraries (add them to turingos.list.chroot)"
    exit 1
fi

echo "==> [0450-build-ui] Done. Chroot size: $(du -sh / --exclude=/proc --exclude=/sys 2>/dev/null | cut -f1)"
