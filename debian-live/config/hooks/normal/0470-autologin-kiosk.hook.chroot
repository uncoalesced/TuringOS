#!/bin/bash
# 0470-autologin-kiosk.hook.chroot
#
# Boots straight into the TuringOS UI: lightdm autologins `user` into an
# openbox session, and /etc/xdg/openbox/autostart (includes.chroot) starts
# turingos-ui in kiosk mode.
#
# live-config creates `user` at boot. If lightdm starts first, autologin
# fails silently and the greeter shows (see ../../../KNOWN_ISSUES.md), so
# lightdm is ordered after live-config.

set -euo pipefail

echo "==> [0470-autologin-kiosk] Configuring lightdm autologin..."

mkdir -p /etc/lightdm/lightdm.conf.d
cat > /etc/lightdm/lightdm.conf.d/50-autologin.conf <<'EOF'
[Seat:*]
autologin-user=user
autologin-user-timeout=0
autologin-session=openbox
user-session=openbox
EOF

mkdir -p /etc/systemd/system/lightdm.service.d
cat > /etc/systemd/system/lightdm.service.d/10-after-live-config.conf <<'EOF'
[Unit]
# The live user must exist before lightdm tries to log it in
After=live-config.service
Wants=live-config.service
EOF

if [[ ! -f /usr/share/xsessions/openbox.desktop ]]; then
    echo "ERROR: openbox session file missing; autologin-session=openbox would fail"
    exit 1
fi

echo "==> [0470-autologin-kiosk] Done."
