#!/bin/bash
# 0470-autologin-kiosk.hook.chroot
#
# Boots straight into the TuringOS UI: lightdm autologins `user` into the
# Hyprland session (session/turingos-hyprland), which starts the desktop
# service and the shell window (turingos-hyprland-autostart). That session
# falls back to the X+openbox session on the same VT when the machine has
# no render node or Hyprland dies, so both session files must exist —
# checked here, at image build time.
#
# live-config creates `user` at boot. If lightdm starts first, autologin
# fails silently and the greeter shows (see ../../../KNOWN_ISSUES.md), so
# lightdm is ordered after live-config.

set -euo pipefail

echo "==> [0470-autologin-kiosk] Configuring lightdm autologin..."

mkdir -p /etc/lightdm/lightdm.conf.d
cat > /etc/lightdm/lightdm.conf.d/50-autologin.conf <<'EOF'
[Seat:*]
autologin-user=user
autologin-user-timeout=0
autologin-session=turingos-hyprland
user-session=turingos-hyprland
EOF

# The session entry itself: includes.chroot/usr is gitignored (sync-scripts
# owns that tree), so the .desktop is written here, like the lightdm conf
mkdir -p /usr/share/wayland-sessions
cat > /usr/share/wayland-sessions/turingos-hyprland.desktop <<'EOF'
[Desktop Entry]
Name=TuringOS
Comment=TuringOS desktop (Hyprland; falls back to X+Openbox when the machine can't composite)
Exec=/usr/lib/turingos/session/turingos-hyprland
Type=Application
DesktopNames=TuringOS
EOF

mkdir -p /etc/systemd/system/lightdm.service.d
cat > /etc/systemd/system/lightdm.service.d/10-after-live-config.conf <<'EOF'
[Unit]
# The live user must exist before lightdm tries to log it in
After=live-config.service
Wants=live-config.service
EOF

if [[ ! -x /usr/lib/turingos/session/turingos-hyprland ]]; then
    echo "ERROR: session launcher missing (sync-scripts.sh not staged before the build?)"
    exit 1
fi
if [[ ! -f /usr/share/wayland-sessions/turingos-hyprland.desktop ]]; then
    echo "ERROR: Hyprland session file missing; autologin-session=turingos-hyprland would fail"
    exit 1
fi
if [[ ! -f /usr/share/xsessions/openbox.desktop ]]; then
    echo "ERROR: openbox session file missing; the no-GPU fallback would fail"
    exit 1
fi

echo "==> [0470-autologin-kiosk] Done."
