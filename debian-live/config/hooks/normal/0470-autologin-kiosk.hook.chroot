#!/bin/bash
# 0470-autologin-kiosk.hook.chroot
#
# Wires lightdm autologin + openbox autostart so the ClaudeOS Electron UI
# launches full-screen automatically on boot, no login prompt.
#
# Runs AFTER 0460 (Electron pre-bundled) so claudeos-ui is ready to launch.
# live-build's default live user is 'user'.

set -euo pipefail

echo "==> [0470-autologin-kiosk] Configuring autologin + kiosk autostart..."

mkdir -p /etc/lightdm/lightdm.conf.d
cat > /etc/lightdm/lightdm.conf.d/50-autologin.conf <<'EOF'
[Seat:*]
autologin-user=user
autologin-user-timeout=0
autologin-session=openbox
user-session=openbox
EOF

mkdir -p /etc/xdg/openbox
cat > /etc/xdg/openbox/autostart <<'EOF'
xset s off
xset -dpms
xset s noblank
KIOSK=1 /usr/local/bin/claudeos-ui &
EOF

echo "==> [0470-autologin-kiosk] Done."
