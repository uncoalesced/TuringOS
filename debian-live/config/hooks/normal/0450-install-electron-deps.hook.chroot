#!/bin/bash
# 0450-install-electron-deps.hook.chroot
#
# Installs all system libraries required by Electron 44 on Debian.
# Must run BEFORE 0460-prebundle-electron (which runs npm install).
#
# Electron is essentially Chromium. It needs the same native libs.
# Missing any of these causes silent launch failures or a black window.
#
# Reference: https://www.electronjs.org/docs/latest/development/build-instructions-linux

set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

echo "==> [0450-electron-deps] Installing Electron system dependencies..."

apt-get install -y \
    `# ── Core graphics / display ───────────────────────────────────────` \
    libgtk-3-0 \
    libgdk-pixbuf2.0-0 \
    libcairo2 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libglib2.0-0 \
    `# ── X11 / Wayland ─────────────────────────────────────────────────` \
    libx11-6 \
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxi6 \
    libxrandr2 \
    libxrender1 \
    libxtst6 \
    libxss1 \
    libx11-xcb1 \
    libxcb-dri3-0 \
    libxcb1 \
    `# ── GPU / DRM (software fallback path also needs these) ───────────` \
    libdrm2 \
    libgbm1 \
    libgl1 \
    libgl1-mesa-dri \
    libglx-mesa0 \
    libegl1 \
    libegl-mesa0 \
    `# ── Audio (Electron links against PulseAudio) ──────────────────────` \
    libpulse0 \
    libasound2 \
    `# ── NSS / crypto (Chromium needs these for HTTPS) ─────────────────` \
    libnss3 \
    libnspr4 \
    `# ── Misc Chromium dependencies ────────────────────────────────────` \
    libdbus-1-3 \
    libexpat1 \
    libfontconfig1 \
    libfreetype6 \
    libudev1 \
    libatspi2.0-0 \
    libcups2 \
    `# ── Sandbox support ───────────────────────────────────────────────` \
    libcap2 \
    `# ── Node native addon build tools (google-auth-library may need) ──` \
    python3 \
    make \
    g++

echo "==> [0450-electron-deps] Verifying key libraries are present..."

REQUIRED_LIBS=(
    "libgtk-3.so.0"
    "libnss3.so"
    "libgbm.so.1"
    "libdrm.so.2"
    "libEGL.so.1"
)

ALL_OK=true
for lib in "${REQUIRED_LIBS[@]}"; do
    if ldconfig -p 2>/dev/null | grep -q "$lib"; then
        echo "  ✓ $lib"
    else
        echo "  ✗ $lib — NOT FOUND (Electron may fail to launch)"
        ALL_OK=false
    fi
done

if ! $ALL_OK; then
    echo "==> [0450-electron-deps] WARNING: some libraries missing — check apt output above"
else
    echo "==> [0450-electron-deps] All required libraries present."
fi

# ── AppArmor / sandbox config ────────────────────────────────────────────────
# Debian restricts unprivileged user namespaces by default on some releases.
# Electron's sandbox requires them. We write a sysctl override so the UI
# launches without --no-sandbox (more secure).
#
# run.sh already detects this and adds --no-sandbox automatically if needed,
# but setting it here means we don't need the fallback.

SYSCTL_CONF="/etc/sysctl.d/99-claudeos-electron.conf"
if [[ -f /proc/sys/kernel/unprivileged_userns_clone ]]; then
    echo "kernel.unprivileged_userns_clone = 1" > "$SYSCTL_CONF"
    echo "==> [0450-electron-deps] Enabled unprivileged user namespaces for Electron sandbox"
fi

if [[ -f /proc/sys/kernel/apparmor_restrict_unprivileged_userns ]]; then
    echo "kernel.apparmor_restrict_unprivileged_userns = 0" >> "$SYSCTL_CONF"
    echo "==> [0450-electron-deps] Relaxed AppArmor unprivileged namespace restriction"
fi

apt-get clean

echo "==> [0450-electron-deps] Done."
echo "==> Chroot size: $(du -sh / --exclude=/proc --exclude=/sys 2>/dev/null | cut -f1)"
