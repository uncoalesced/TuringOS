# Engineered by uncoalesced
# TuringOS boot splash (plymouth script plugin).
# Design language: black is the room; the mark sits just above centre; the one
# live thing is an orange dot that breathes while the system starts; the brand
# gradient runs once, as a strip along the bottom edge.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

sw = Window.GetWidth();
sh = Window.GetHeight();

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = sw / 2 - logo.image.GetWidth() / 2;
logo.y = sh / 2 - logo.image.GetHeight() / 2 - sh / 12;
logo.sprite.SetPosition(logo.x, logo.y, 1);

dot.image = Image("dot.png");
dot.sprite = Sprite(dot.image);
dot.y = logo.y + logo.image.GetHeight() + sh / 14;
dot.sprite.SetPosition(sw / 2 - dot.image.GetWidth() / 2, dot.y, 2);

strip.image = Image("strip.png").Scale(sw, 3);
strip.sprite = Sprite(strip.image);
strip.sprite.SetPosition(0, sh - 3, 1);

tick = 0;
fun refresh_callback() {
    tick = tick + 1;
    # ~50 calls a second: one breath every two seconds, never fully dark
    dot.sprite.SetOpacity(0.55 + 0.45 * Math.Sin(tick * 3.14159 / 50));
}
Plymouth.SetRefreshFunction(refresh_callback);

# Password prompts (encrypted disks): the prompt and a row of bullets under the dot
prompt.sprite = Sprite();
fun display_password_callback(text, bullets) {
    stars = "";
    i = 0;
    while (i < bullets) {
        stars = stars + "*";
        i = i + 1;
    }
    prompt.image = Image.Text(text + "  " + stars, 0.976, 0.976, 0.976);
    prompt.sprite.SetImage(prompt.image);
    prompt.sprite.SetPosition(sw / 2 - prompt.image.GetWidth() / 2, dot.y + sh / 10, 3);
    prompt.sprite.SetOpacity(1);
}
fun display_normal_callback() {
    prompt.sprite.SetOpacity(0);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);

message.sprite = Sprite();
fun message_callback(text) {
    message.image = Image.Text(text, 0.655, 0.655, 0.655);
    message.sprite.SetImage(message.image);
    message.sprite.SetPosition(sw / 2 - message.image.GetWidth() / 2, sh - sh / 8, 3);
}
Plymouth.SetMessageFunction(message_callback);
