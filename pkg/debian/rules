#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_build:
	# Nothing to build — pure Bash

override_dh_auto_install:
	install -Dm755 ../claudeos                       debian/claudeos/usr/local/bin/claudeos
	install -Dm644 ../core/config.sh                  debian/claudeos/usr/lib/claudeos/core/config.sh
	install -Dm644 ../core/ui.sh                      debian/claudeos/usr/lib/claudeos/core/ui.sh
	install -Dm644 ../core/logging.sh                 debian/claudeos/usr/lib/claudeos/core/logging.sh
	install -Dm644 ../agent/claude.sh                 debian/claudeos/usr/lib/claudeos/agent/claude.sh
	install -Dm644 ../sandbox/btrfs.sh                debian/claudeos/usr/lib/claudeos/sandbox/btrfs.sh
	install -Dm644 ../sandbox/diff.sh                 debian/claudeos/usr/lib/claudeos/sandbox/diff.sh
	install -Dm644 ../bazaar/registry.sh              debian/claudeos/usr/lib/claudeos/bazaar/registry.sh
	install -Dm644 ../bazaar/install.sh               debian/claudeos/usr/lib/claudeos/bazaar/install.sh
	install -Dm644 ../bazaar/registry.json            debian/claudeos/usr/lib/claudeos/bazaar/registry.json
	install -Dm644 ../game/gamemode.sh                debian/claudeos/usr/lib/claudeos/game/gamemode.sh
	install -Dm644 ../monitor/system.sh               debian/claudeos/usr/lib/claudeos/monitor/system.sh
	install -Dm644 ../WORKFLOW.md                     debian/claudeos/usr/share/doc/claudeos/WORKFLOW.md
	install -Dm644 ../plan.md                         debian/claudeos/usr/share/doc/claudeos/plan.md
	install -Dm755 claudeos-first-run.sh              debian/claudeos/etc/profile.d/claudeos-first-run.sh
