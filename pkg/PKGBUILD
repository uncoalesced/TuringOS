# Maintainer: TuringOS Contributors <mail@uncoalesced.com>
# Contributor: Stavin Fernandes <stavinfernandes2098@gmail.com>

pkgname=turingos
pkgver=0.1.0
pkgrel=1
pkgdesc="Agentic layer for CachyOS — Btrfs sandboxing, MCP registry, Game Mode"
arch=('any')
url="https://github.com/uncoalesced/TuringOS"
license=('MIT')
install=turingos.install

# ─── Dependencies ─────────────────────────────────────────────────────────────
# bash, procps-ng, util-linux are in base — not listed per Arch guidelines.

depends=(
    'git'           # sandbox diff/merge, bazaar clone
    'jq'            # state.json, MCP config injection, registry parsing
    'btrfs-progs'   # btrfs subvolume snapshot/delete
    'libnotify'     # notify-send for agent completion notifications
)

optdepends=(
    'rsync: sandbox copy-backend fallback when project is not on btrfs'
    'curl: required by turingos-install-claude-cli.sh native installer'
    'gum: interactive terminal UI — browse, confirm, choose prompts (AUR)'
    'fzf: fuzzy finder for Bazaar browser and sandbox picker'
    'nodejs: required for npx-based MCP tool installs'
    'npm: required for npx-based MCP tool installs'
    'nvidia-utils: GPU monitoring in system HUD via nvidia-smi'
    'rocm-smi-lib: GPU monitoring for AMD GPUs via rocm-smi'
    'git-delta: enhanced git diff rendering in sandbox diff view'
    'diff-so-fancy: alternative enhanced git diff renderer'
)

# ─── Source ───────────────────────────────────────────────────────────────────
# Local checkout build (hackathon mode).
# For AUR publication, replace with:
#   source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/v${pkgver}.tar.gz")
#   sha256sums=('SKIP')
#
# For now, package() resolves the repo root via ${startdir}.
# ${startdir} is the directory makepkg was invoked from — i.e., pkg/.
# The repo root is one level up.

# ─── Check (optional lint) ────────────────────────────────────────────────────

check() {
    local _reporoot="${startdir}/.."

    if ! command -v shellcheck &>/dev/null; then
        echo "shellcheck not found — skipping lint (install with: sudo pacman -S shellcheck)"
        return 0
    fi

    echo "Running shellcheck on TuringOS scripts..."

    local scripts=(
        "${_reporoot}/turingos"
        "${_reporoot}/core/config.sh"
        "${_reporoot}/core/ui.sh"
        "${_reporoot}/core/logging.sh"
        "${_reporoot}/agent/claude.sh"
        "${_reporoot}/agent/nim.sh"
        "${_reporoot}/sandbox/btrfs.sh"
        "${_reporoot}/sandbox/diff.sh"
        "${_reporoot}/bazaar/registry.sh"
        "${_reporoot}/bazaar/install.sh"
        "${_reporoot}/game/gamemode.sh"
        "${_reporoot}/monitor/system.sh"
        "${_reporoot}/pkg/turingos-first-run.sh"
        "${_reporoot}/pkg/turingos-install-claude-cli.sh"
    )

    # SC1091 — don't follow sourced files (they resolve at runtime)
    # SC2034 — unused variable warnings (many are exported for subshells)
    shellcheck --shell=bash \
        --exclude=SC1091,SC2034 \
        "${scripts[@]}"

    echo "shellcheck passed."
}

# ─── Package ──────────────────────────────────────────────────────────────────

package() {
    local _reporoot="${startdir}/.."

    # ── License ───────────────────────────────────────────────────────────────
    install -Dm644 "${_reporoot}/LICENSE" \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

    # ── Main executable ───────────────────────────────────────────────────────
    install -Dm755 "${_reporoot}/turingos" \
        "${pkgdir}/usr/bin/turingos"

    # ── Core library ──────────────────────────────────────────────────────────
    install -Dm644 "${_reporoot}/core/config.sh"  \
        "${pkgdir}/usr/lib/turingos/core/config.sh"
    install -Dm644 "${_reporoot}/core/ui.sh"      \
        "${pkgdir}/usr/lib/turingos/core/ui.sh"
    install -Dm644 "${_reporoot}/core/logging.sh" \
        "${pkgdir}/usr/lib/turingos/core/logging.sh"

    # ── Agent ─────────────────────────────────────────────────────────────────
    install -Dm644 "${_reporoot}/agent/claude.sh" \
        "${pkgdir}/usr/lib/turingos/agent/claude.sh"
    install -Dm644 "${_reporoot}/agent/nim.sh" \
        "${pkgdir}/usr/lib/turingos/agent/nim.sh"

    # ── Sandbox ───────────────────────────────────────────────────────────────
    install -Dm644 "${_reporoot}/sandbox/btrfs.sh" \
        "${pkgdir}/usr/lib/turingos/sandbox/btrfs.sh"
    install -Dm644 "${_reporoot}/sandbox/diff.sh"  \
        "${pkgdir}/usr/lib/turingos/sandbox/diff.sh"

    # ── Bazaar ────────────────────────────────────────────────────────────────
    install -Dm644 "${_reporoot}/bazaar/registry.sh"   \
        "${pkgdir}/usr/lib/turingos/bazaar/registry.sh"
    install -Dm644 "${_reporoot}/bazaar/install.sh"    \
        "${pkgdir}/usr/lib/turingos/bazaar/install.sh"
    install -Dm644 "${_reporoot}/bazaar/registry.json" \
        "${pkgdir}/usr/lib/turingos/bazaar/registry.json"

    # ── Game Mode ─────────────────────────────────────────────────────────────
    install -Dm644 "${_reporoot}/game/gamemode.sh" \
        "${pkgdir}/usr/lib/turingos/game/gamemode.sh"

    # ── Monitor ───────────────────────────────────────────────────────────────
    install -Dm644 "${_reporoot}/monitor/system.sh" \
        "${pkgdir}/usr/lib/turingos/monitor/system.sh"

    # ── Claude CLI installer ──────────────────────────────────────────────────
    install -Dm755 "${_reporoot}/pkg/turingos-install-claude-cli.sh" \
        "${pkgdir}/usr/lib/turingos/pkg/turingos-install-claude-cli.sh"

    # ── First-run profile.d hook ──────────────────────────────────────────────
    # mode 644 — profile.d files are sourced, not executed directly
    install -Dm644 "${_reporoot}/pkg/turingos-first-run.sh" \
        "${pkgdir}/etc/profile.d/turingos-first-run.sh"

    # ── Docs ──────────────────────────────────────────────────────────────────
    install -Dm644 "${_reporoot}/WORKFLOW.md" \
        "${pkgdir}/usr/share/doc/${pkgname}/WORKFLOW.md"
    install -Dm644 "${_reporoot}/plan.md" \
        "${pkgdir}/usr/share/doc/${pkgname}/plan.md"
    install -Dm644 "${_reporoot}/pkg/ISO_BUILD.md" \
        "${pkgdir}/usr/share/doc/${pkgname}/ISO_BUILD.md"
}
