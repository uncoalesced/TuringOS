[Unit]
Description=TuringOS Bridge WebSocket Server
After=turingos-capd.service turingos-agentd-plan.service turingos-agentd-llm.service turingos-memoryd.service turingos-bridged.service
Before=turingos-shell.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/lib/turingos/daemons/bridged-ws.py
Restart=on-failure
RestartSec=1
User=turingos
Group=turingos
Environment=PYTHONPATH=/usr/lib/turingos

[Install]
WantedBy=multi-user.target