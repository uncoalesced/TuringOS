[Unit]
Description=TuringOS Bridge WebSocket Server
Documentation=man:turingos-bridged-ws(8)
After=turingos-capd.service turingos-agentd-plan.service turingos-agentd-llm.service turingos-memoryd.service turingos-bridged.service turingos-toolreg.service turingos-auditd.service
Before=turingos-shell.service
ConditionPathExists=!/etc/turingos/disable-bridged-ws

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/lib/turingos/daemons/bridged-ws.py
Restart=on-failure
RestartSec=1
User=turingos
Group=turingos
StandardOutput=journal
StandardError=journal

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/turingos /usr/lib/turingos/ui/web

[Install]
WantedBy=multi-user.target