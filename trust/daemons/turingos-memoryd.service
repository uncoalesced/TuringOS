[Unit]
Description=TuringOS Memory Daemon
Documentation=man:turingos-memoryd(8)
After=turingos-auditd.service
Before=turingos-agentd-plan.service turingos-bridged-ws.service
ConditionPathExists=!/etc/turingos/disable-memoryd

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/lib/turingos/daemons/memoryd.py
Restart=on-failure
RestartSec=1
User=turingos
Group=turingos
StandardOutput=journal
StandardError=journal

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/turingos ~/.turingos

[Install]
WantedBy=multi-user.target