[Unit]
Description=TuringOS Sandbox Daemon
Documentation=man:turingos-sandboxd(8)
After=turingos-capd.service turingos-auditd.service
Before=turingos-agentd-plan.service turingos-bridged-ws.service
ConditionPathExists=!/etc/turingos/disable-sandboxd

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/lib/turingos/daemons/sandboxd.py
Restart=on-failure
RestartSec=1
User=turingos
Group=turingos
StandardOutput=journal
StandardError=journal

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/turingos /tmp
# Need CAP_SYS_ADMIN for bubblewrap
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_RESOURCE CAP_DAC_OVERRIDE CAP_FOWNER

[Install]
WantedBy=multi-user.target