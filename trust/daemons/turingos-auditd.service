[Unit]
Description=TuringOS Audit Daemon
After=local-fs.target
Before=turingos-capd.service turingos-sandboxd.service turingos-agentd.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/lib/turingos/daemons/auditd.py
Restart=on-failure
RestartSec=1
User=turingos-audit
Group=turingos-audit

[Install]
WantedBy=multi-user.target
