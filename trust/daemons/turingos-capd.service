[Unit]
Description=TuringOS Capability Daemon
After=turingos-auditd.service
Before=turingos-sandboxd.service turingos-agentd.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/lib/turingos/daemons/capd.py
Restart=on-failure
RestartSec=1
User=turingos
Group=turingos

[Install]
WantedBy=multi-user.target
