[Unit]
Description=TuringOS Capability Daemon
Documentation=man:turingos-capd(8)
After=turingos-auditd.service
Before=turingos-sandboxd.service turingos-agentd-plan.service turingos-bridged-ws.service
ConditionPathExists=!/etc/turingos/disable-capd

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/lib/turingos/daemons/capd.py
Restart=on-failure
RestartSec=1
User=turingos
Group=turingos
StandardOutput=journal
StandardError=journal

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/turingos /run/turingos

[Install]
WantedBy=multi-user.target