[Unit]
Description=TuringOS Agent Plan Daemon
Documentation=man:turingos-agentd-plan(8)
After=turingos-capd.service turingos-sandboxd.service turingos-memoryd.service turingos-auditd.service
Before=turingos-bridged-ws.service
ConditionPathExists=!/etc/turingos/disable-agentd-plan

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/lib/turingos/daemons/agentd-plan.py
Restart=on-failure
RestartSec=1
User=turingos
Group=turingos
StandardOutput=journal
StandardError=journal

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/turingos ~/.turingos /var/lib/turingos

[Install]
WantedBy=multi-user.target