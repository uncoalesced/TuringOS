[Unit]
Description=TuringOS Tool Registry Daemon
Documentation=man:turingos-toolreg(8)
After=turingos-auditd.service
Before=turingos-agentd-plan.service turingos-bridged-ws.service
ConditionPathExists=!/etc/turingos/disable-toolreg

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/lib/turingos/daemons/toolreg.py
Restart=on-failure
RestartSec=1
User=turingos
Group=turingos
StandardOutput=journal
StandardError=journal

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/turingos /etc/turingos/tools.d ~/.turingos/tools.d

[Install]
WantedBy=multi-user.target