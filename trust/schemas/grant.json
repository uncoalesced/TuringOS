{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turingos.ai/schemas/grant.json",
  "title": "CapabilityGrant",
  "description": "A scoped, expiring authorization for a subject to perform actions. No standing permissions — every tool call requires a grant.",
  "type": "object",
  "required": ["version", "grant_id", "subject", "session_id", "issued_by", "capabilities", "expires_at", "revocable"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "grant_id": {
      "type": "string",
      "pattern": "^01[A-Z0-9]{20,}$",
      "description": "ULID or similar unique identifier"
    },
    "subject": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["user", "agent", "tool", "service"]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "session_id": {
      "type": "string",
      "pattern": "^01[A-Z0-9]{20,}$"
    },
    "issued_by": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["user", "agent", "policy"]
        },
        "id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["fs.read", "fs.write", "fs.execute", "net.egress", "sandbox.spawn", "memory.read", "memory.write", "bridge.egress"]
          },
          "paths": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Glob patterns for fs.* capabilities"
          },
          "domains": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Allowed domains for net.egress and bridge.egress"
          }
        },
        "additionalProperties": false
      }
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "revocable": {
      "type": "boolean"
    },
    "signature": {
      "type": "string",
      "description": "ed25519 signature over the grant contents"
    }
  },
  "additionalProperties": false
}
